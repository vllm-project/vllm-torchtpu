// cdk.llmd — the llm-d Router (EPP + Envoy), its endpoint discovery, and the decode routing
// sidecar, as functions, for CDK JobSet recipes that serve prefill/decode behind llm-d.
//
//     local llmd = import 'cdk.llmd';
//     local k = llmd.knobs();                                   // EPP_* / LLMD_* / THUNDER_* vars
//     local cfg = llmd.eppConfig(cdk.var('EPP_PROFILE', 'sessaff'), k);
//     llmd.routerJob(eppConfig=cfg, prefillHosts=[...], decodeHosts=[...],
//                    prefillPort=8000, decodePort=llmd.sidecarPort, decodeHealthPort=7200)
//     llmd.decodeSidecar(modelServerPort=7200)
//
// Install as recipes/lib/cdk.llmd in cloud-devkit-recipes (recipes/lib is on the import path).
//
// Why this exists. CDK accepts exactly one JobSet per recipe, assigns the service account itself
// (serviceAccountName is rejected at submit) and offers no way to create Services, ConfigMaps,
// InferencePools or RBAC. The llm-d Router chart needs all of those in its Kubernetes mode: the
// EPP watches an InferencePool or, in standalone mode, watches pods through a Role. Neither is
// available to a CDK job. llm-d-router's `file-discovery` data layer plugin (Beta, in the EPP
// image since 2026-05-25) starts the EPP without a controller manager, without the InferencePool
// CRD and without any RBAC: it reads the endpoint list from a file and reloads it on change. In
// a JobSet the endpoint set is known at render time (the headless-service DNS names of the
// prefill and decode pods), so the Router is one more replicated job here:
//
//   router pod = [init: write the EPP config, the Envoy config and an empty endpoints file]
//                + envoy (listener :8081, ext_proc to 127.0.0.1:9002, plaintext)
//                + epp   (--config-file, file-discovery, --secure-serving=false)
//                + endpoint-resolver (resolves the pod DNS names to IPv4, admits a pod after its
//                  engine's /health answers 200, rewrites the endpoints file atomically; the EPP
//                  reloads it)
//
// and the decode pod carries the llm-d routing sidecar (:8000 -> vLLM :7200), exactly as the
// Deployments of guides/pd-disaggregation/raiden-do-NOT-push/recipes/pd/pd-rc do on the raiden
// cluster (KV transfer through the sidecar confirmed there on 2026-10-16 with TPURaidenConnector
// and --kv-connector=nixlv2). A decode endpoint is registered at the sidecar's port but admitted
// on the engine's own port: the sidecar answers GET /health with 200 unconditionally
// (pkg/sidecar/proxy/proxy.go, createRoutes), so its /health says nothing about the engine.
//
// What is configurable per job (every value is a `cdk job create` variable):
//
//   EPP_PROFILE          which EndpointPickerConfig to run (see `presets` below):
//                          sessaff        session affinity with subagent co-location, no flow
//                                         control (router-pd-rc.values.yaml; P/D baseline)
//                          turn-priority  sessaff + flowControl + agent-identity +
//                                         program-aware-fairness/turn-priority
//                                         (router-pd-rc-turn-priority.values.yaml)
//                          admission      sessaff + flowControl gated by a utilization-detector
//                                         (queue depth / KV utilization thresholds), no
//                                         fairness policy: plain admission control
//                          sticky-approx  approx-prefix-cache-producer + prefix-cache-affinity-
//                                         filter tuned for this engine (epp-sticky-approx.values.yaml)
//                          sessaff-prefix sticky-approx prefill + decode session-affinity-filter
//                                         with prefix-cache-scorer (weight 8) and
//                                         active-request-scorer (weight 1) for first-turn placement
//                          sessaff-spill  sticky-approx prefill + fail-open decode-spill
//                                         (utilization-detector) before session-affinity-decode +
//                                         balanced prefix/active/running/kv decode scorers
//                          pd-soft-affinity (alias: sessaff-soft)
//                                         sticky-approx prefill + fail-open decode-spill + soft
//                                         prefix-cache-scorer, queue-scorer,
//                                         running-requests-size-scorer, active-request-scorer, and
//                                         kv-cache-utilization-scorer on decode (no hard
//                                         session-affinity-filter; avoids slot-blocking at low cap)
//                          pd-default     the llm-d guide's P/D configuration (autoTune on)
//                          thunder        thunder-agent session admission control; the plugin's
//                                         README states P/D is not supported, so this preset
//                                         renders only with EPP_ACK_UNSUPPORTED=true
//                          custom         EPP_CONFIG_JSON verbatim (plugins/schedulingProfiles/
//                                         featureGates/flowControl); discovery is still added
//   EPP_CONFIG_PATCH     JSON merge patch (RFC 7396) applied over the chosen preset. Maps merge,
//                        lists replace, null deletes: good for flowControl.defaultRequestTTL or
//                        a plugin parameter block, not for editing one entry of `plugins`.
//   EPP_REQUEST_TTL, EPP_TURN_TIME_WEIGHT, EPP_TURN_INACTIVITY_S, EPP_SESSION_TTL_S,
//   EPP_SATURATION_QUEUE_DEPTH, EPP_SATURATION_KV_UTIL, EPP_APPROX_*, THUNDER_*
//                        the preset parameters, see knobs() for names and defaults.
//   LLMD_EPP_IMAGE, LLMD_ENVOY_IMAGE, LLMD_SIDECAR_IMAGE, LLMD_RESOLVER_IMAGE
//                        images; point them at an Artifact Registry mirror when the cluster
//                        cannot pull ghcr.io / docker.io.
//   LLMD_EPP_V           EPP log verbosity (--v), default 2.
//   LLMD_EPP_CPU / LLMD_EPP_MEMORY / LLMD_ENVOY_CPU / LLMD_ENVOY_MEMORY   router pod requests.
//   LLMD_SIDECAR_PREFILL_MAX_RETRIES, LLMD_SIDECAR_PREFILL_RETRY_BACKOFF
//                        the sidecar's retry of a prefill request that came back 502/503/504
//                        (--prefill-max-retries, --prefill-retry-backoff); defaults 2 and
//                        200ms, see decodeSidecar().
//
// Keep-alive between the sidecar and the engines. The sidecar's reverse-proxy transports keep
// idle connections for 90 s (IdleConnTimeout in pkg/sidecar/proxy/proxy.go, not a flag) and
// reuse them for the next request; vLLM's uvicorn closes an idle connection after
// VLLM_HTTP_TIMEOUT_KEEP_ALIVE seconds, 5 by default. With the server-side timeout below the
// client-side one, the sidecar writes requests onto sockets the engine is closing at that
// moment, and the engine's close turns into a TCP reset that the sidecar reports as 502 with
// nothing in the engine's log (j-8830a15b-3b66-4bbd-bb99: 59 of 20009 requests, 36 on the
// decode engine at 127.0.0.1:7200 after a successful prefill, 23 on the prefill engine).
// Every engine behind the sidecar therefore needs VLLM_HTTP_TIMEOUT_KEEP_ALIVE above
// sidecarIdleConnTimeoutSeconds so that the sidecar, not the engine, closes idle sockets;
// engineKeepAliveSeconds is the default to use and assertEngineKeepAlive() the render-time
// check. The prefill retry above covers the prefill side of the same failure when it does
// happen anyway; the decode side goes through httputil.ReverseProxy and is never retried.
//
// Everything a preset emits is data (jsonnet objects), serialized with std.manifestYamlDoc into
// the file the EPP reads, so a new preset is one more entry in `presets` and a parameter change
// is a variable, not an edited YAML blob.

local cdk = import 'cdk.common';

{
  // ---------------------------------------------------------------------------
  // Images, ports, paths
  // ---------------------------------------------------------------------------
  defaultEppImage:: 'ghcr.io/llm-d/llm-d-router-endpoint-picker:main',
  defaultEnvoyImage:: 'docker.io/envoyproxy/envoy:distroless-v1.33.2',
  defaultSidecarImage:: 'ghcr.io/llm-d/llm-d-router-disagg-sidecar:main',
  // The endpoint resolver needs DNS, HTTP and an atomic file write; python's standard library
  // has all three and the image is small. Any python3 image works.
  defaultResolverImage:: 'python:3.12-slim',

  listenerPort:: 8081,  // Envoy, what clients talk to
  eppGrpcPort:: 9002,  // ext_proc
  eppHealthPort:: 9003,
  eppMetricsPort:: 9090,
  sidecarPort:: 8000,  // routing sidecar on the decode pod

  // The sidecar's http.Transport IdleConnTimeout (pkg/sidecar/proxy/proxy.go, newProxyTransport;
  // hard-coded, no flag). An engine's VLLM_HTTP_TIMEOUT_KEEP_ALIVE must exceed it, see the
  // header; engineKeepAliveSeconds is the default recipes should give the engines.
  sidecarIdleConnTimeoutSeconds:: 90,
  engineKeepAliveSeconds:: 300,

  // assertEngineKeepAlive(role, seconds) is the render-time check that one engine's
  // VLLM_HTTP_TIMEOUT_KEEP_ALIVE is above the sidecar's idle-connection timeout. Returns true
  // (for use in an `assert`), fails the render with the reason otherwise.
  assertEngineKeepAlive(role, seconds)::
    if std.isNumber(seconds) && seconds > $.sidecarIdleConnTimeoutSeconds then true
    else error ('%s engine VLLM_HTTP_TIMEOUT_KEEP_ALIVE=%s must be above the routing sidecar\'s '
                + 'idle-connection timeout of %d s (otherwise the sidecar reuses sockets the engine '
                + 'is closing and those requests fail with 502); the default is %d')
               % [role, std.toString(seconds), $.sidecarIdleConnTimeoutSeconds, $.engineKeepAliveSeconds],

  configDir:: '/etc/llm-d',
  eppConfigPath:: $.configDir + '/epp-config.yaml',
  envoyConfigPath:: $.configDir + '/envoy.yaml',
  endpointsPath:: $.configDir + '/endpoints.json',
  configVolumeName:: 'llm-d-config',

  // The session headers aiperf sends with AIPERF_HTTP_X_DYNAMO_SESSION_ID_FROM_CORRELATION_ID=true:
  // every request carries X-Dynamo-Session-ID, a subagent child also carries
  // X-Dynamo-Parent-Session-ID. Parent first, so a child resolves to its parent's session and
  // is pinned (and accounted) with it.
  sessionHeaders:: ['x-dynamo-parent-session-id', 'x-dynamo-session-id'],

  // ---------------------------------------------------------------------------
  // Variables
  // ---------------------------------------------------------------------------

  // knobs reads every preset parameter from the recipe variables, with the defaults the raiden
  // experiments ran on. A recipe passes overrides to pin a value (e.g. the engine's
  // max-model-len as approxMaxPrefixTokens) and passes its preset-aware `cdk` instance when
  // wrapping with presets.
  knobs(overrides={}, cdk=cdk):: {
    // Flow control: queue-wait budget while the pool has endpoints. 600 s since the turn-priority
    // revision 2 (60 s shed root warmup requests with 429 and aborted the AgentX run); it stays
    // under Envoy's ext_proc message_timeout of 1000 s and aiperf's warmup grace of 1800 s.
    requestTtl: cdk.var('EPP_REQUEST_TTL', '600s'),
    // program-aware-fairness, strategy turn-priority: score = turnNumber + weight * headWaitSeconds.
    turnTimeWeight: cdk.numVar('EPP_TURN_TIME_WEIGHT', 0.05),
    turnInactivitySeconds: cdk.numVar('EPP_TURN_INACTIVITY_S', 120),
    // session-affinity-filter bindings expire after this many seconds unused.
    sessionTtlSeconds: cdk.numVar('EPP_SESSION_TTL_S', 14400),
    // utilization-detector thresholds for the `admission` preset (the plugin defaults).
    saturationQueueDepth: cdk.numVar('EPP_SATURATION_QUEUE_DEPTH', 5),
    saturationKvUtil: cdk.numVar('EPP_SATURATION_KV_UTIL', 0.8),
    // Per-leg fail-open utilization-detector spill thresholds and decode scorer weights for
    // `sessaff-spill` and `pd-soft-affinity` (`sessaff-soft`). Defining a `utilization-detector`
    // plugin with generous prefill thresholds (48 waiting requests, 0.98 HBM KV) also prevents
    // `ensureSaturationDetector` in the EPP config loader from auto-injecting a default
    // `queueDepthThreshold=5, kvCacheUtilThreshold=0.8` filter into every profile.
    prefillSpillQueueDepth: cdk.numVar('EPP_PREFILL_SPILL_QUEUE_DEPTH', 48),
    prefillSpillKvUtil: cdk.numVar('EPP_PREFILL_SPILL_KV_UTIL', 0.98),
    decodeSpillQueueDepth: cdk.numVar('EPP_DECODE_SPILL_QUEUE_DEPTH', 2),
    decodeSpillKvUtil: cdk.numVar('EPP_DECODE_SPILL_KV_UTIL', 0.90),
    decodePrefixWeight: cdk.numVar('EPP_DECODE_PREFIX_WEIGHT', 8),
    decodeLoadWeight: cdk.numVar('EPP_DECODE_LOAD_WEIGHT', 1),
    decodeQueueWeight: cdk.numVar('EPP_DECODE_QUEUE_WEIGHT', 0),
    decodeRunningWeight: cdk.numVar('EPP_DECODE_RUNNING_WEIGHT', 0),
    decodeKvWeight: cdk.numVar('EPP_DECODE_KV_WEIGHT', 0),
    // approx-prefix-cache-producer / prefix-cache-affinity-filter (sticky-approx, pd-default).
    // 64 is the producer's minimum block; 2,000,000 entries per pod keeps a session on its pod
    // for a whole run; 27000 tok/s is the measured local_compute prompt throughput per prefill
    // pod on tpu7x; 60000 ms keeps a load imbalance below ~1.6M queued tokens from breaking
    // stickiness (see epp-sticky-approx.values.yaml).
    approxBlockSizeTokens: cdk.numVar('EPP_APPROX_BLOCK_TOKENS', 64),
    approxMaxPrefixTokens: cdk.numVar('EPP_APPROX_MAX_PREFIX_TOKENS', 262144),
    approxLruCapacity: cdk.numVar('EPP_APPROX_LRU_CAPACITY', 2000000),
    approxPeakPrefillThroughput: cdk.numVar('EPP_APPROX_PEAK_PREFILL_TPS', 27000),
    approxMaxTtftPenaltyMs: cdk.numVar('EPP_APPROX_MAX_TTFT_PENALTY_MS', 60000),
    // thunder-agent. capacityTokens is only the fallback: the plugin scrapes
    // block_size x num_gpu_blocks from the engine's cache_config_info.
    thunderCapacityTokens: cdk.numVar('THUNDER_CAPACITY_TOKENS', 4194304),
    thunderUtilThreshold: cdk.numVar('THUNDER_UTIL_THRESHOLD', 1.0),
    thunderIdleLeaseSeconds: cdk.numVar('THUNDER_IDLE_LEASE_S', 10),
    thunderHeadWaitMs: cdk.numVar('THUNDER_HEAD_WAIT_MS', 1800000),
    ackUnsupported: cdk.boolVar('EPP_ACK_UNSUPPORTED', false),
  } + overrides,

  // ---------------------------------------------------------------------------
  // EndpointPickerConfig building blocks (P/D)
  // ---------------------------------------------------------------------------

  // Always-disagg P/D: the decode profile picks a decode pod, then the prefill profile picks a
  // prefill pod; the EPP tells the decode sidecar which prefill pod to call.
  pdCorePlugins:: [
    { type: 'always-disagg-pd-decider' },
    { type: 'disagg-profile-handler', parameters: { deciders: { prefill: 'always-disagg-pd-decider' } } },
    { type: 'prefill-filter' },
    { type: 'decode-filter' },
  ],

  sessionIdConfig(k):: {
    sources: [{ header: h } for h in $.sessionHeaders],
    evictionTtlSeconds: k.sessionTtlSeconds,
    evictionSweepSeconds: 30,
  },

  // One session-affinity-filter per profile (strategy session_id): a session is pinned to one
  // prefill pod and one decode pod, a subagent child to its parent's. token-load-scorer places an
  // unbound session on the prefill pod with the least queued prompt work, active-request-scorer
  // on the decode pod with the fewest in-flight requests.
  sessionAffinityPlugins(k):: [
    { type: 'inflight-load-producer' },
    {
      type: 'session-affinity-filter',
      name: 'session-affinity-prefill',
      parameters: { strategy: 'session_id', profileName: 'prefill', sessionIdConfig: $.sessionIdConfig(k) },
    },
    {
      type: 'session-affinity-filter',
      name: 'session-affinity-decode',
      parameters: { strategy: 'session_id', sessionIdConfig: $.sessionIdConfig(k) },
    },
    { type: 'token-load-scorer', name: 'prefill-token-load', parameters: { queueThresholdTokens: 67108864 } },
    { type: 'active-request-scorer', name: 'decode-active-requests' },
    { type: 'max-score-picker' },
  ],

  sessionAffinityProfiles:: [
    {
      name: 'prefill',
      plugins: [
        { pluginRef: 'prefill-filter' },
        { pluginRef: 'session-affinity-prefill' },
        { pluginRef: 'prefill-token-load' },
        { pluginRef: 'max-score-picker' },
      ],
    },
    {
      name: 'decode',
      plugins: [
        { pluginRef: 'decode-filter' },
        { pluginRef: 'session-affinity-decode' },
        { pluginRef: 'decode-active-requests' },
        { pluginRef: 'max-score-picker' },
      ],
    },
  ],

  // Fairness ID = first non-empty session header (checked before the plugin's built-in Claude
  // Code / OpenCode / Codex headers), so one fairness ID is one workflow: root session plus its
  // subagents, the same unit the session filters pin to a pod.
  fairnessPlugins(k):: [
    { type: 'agent-identity', parameters: { additionalSessionHeaders: $.sessionHeaders } },
    {
      type: 'program-aware-fairness',
      parameters: {
        strategy: 'turn-priority',
        turnPriorityTimeWeight: k.turnTimeWeight,
        turnPriorityInactivitySeconds: k.turnInactivitySeconds,
        evictionTtlSeconds: 3600,
        evictionSweepSeconds: 300,
      },
    },
  ],

  approxProfiles:: [
    {
      name: 'prefill',
      plugins: [
        { pluginRef: 'prefill-filter' },
        { pluginRef: 'prefix-cache-affinity-filter' },
        { pluginRef: 'token-load-scorer' },
        { pluginRef: 'max-score-picker' },
      ],
    },
    {
      name: 'decode',
      plugins: [
        { pluginRef: 'decode-filter' },
        { pluginRef: 'active-request-scorer' },
        { pluginRef: 'max-score-picker' },
      ],
    },
  ],

  // ---------------------------------------------------------------------------
  // Presets. Each is a function of the knobs returning the EndpointPickerConfig body
  // (featureGates, plugins, flowControl, schedulingProfiles); eppConfig adds apiVersion/kind
  // and the file-discovery data layer.
  // ---------------------------------------------------------------------------
  presets:: {
    // recipes/pd/pd-rc/router-pd-rc.values.yaml: the P/D baseline measured on the raiden cluster
    // (pd-0929 2P1D c64: equal to sticky-approx, 191.6k vs 190.5k tok/s; pd-rc runs 2 to 5).
    sessaff:: function(k) {
      plugins: $.pdCorePlugins + $.sessionAffinityPlugins(k),
      schedulingProfiles: $.sessionAffinityProfiles,
    },

    // recipes/pd/pd-rc/router-pd-rc-turn-priority.values.yaml: sessaff plus flow control with the
    // program-aware turn-priority fairness policy (deeper sessions dispatch first while the pool
    // is saturated per the default utilization-detector: queue depth > 5 or KV util > 0.8).
    'turn-priority':: function(k) {
      featureGates: ['flowControl'],
      plugins: $.fairnessPlugins(k) + $.pdCorePlugins + $.sessionAffinityPlugins(k),
      flowControl: {
        defaultRequestTTL: k.requestTtl,
        defaultPriorityBand: { fairnessPolicyRef: 'program-aware-fairness' },
      },
      schedulingProfiles: $.sessionAffinityProfiles,
    },

    // sessaff plus the flow-control gate alone: requests wait in the EPP while the pool is
    // saturated (an explicit utilization-detector with the thresholds as variables) and
    // dispatch in the controller's default order. The config loader also appends the detector to
    // every scheduling profile as a filter (pkg/epp/config/loader/defaults.go,
    // ensureSaturationDetector; the same happens to the default detector under turn-priority),
    // which is harmless for a pinned session: the filter runs after session-affinity-filter has
    // narrowed the candidates to the pinned pod, and it is fail-open, returning its input
    // unchanged when every candidate is over the limit (utilization/detector.go, Filter). An
    // unpinned first request is steered away from a pod over the limit while another is under
    // it, which is the behaviour wanted there.
    admission:: function(k) {
      featureGates: ['flowControl'],
      plugins: $.pdCorePlugins + $.sessionAffinityPlugins(k) + [
        {
          type: 'utilization-detector',
          name: 'pool-saturation',
          parameters: {
            queueDepthThreshold: k.saturationQueueDepth,
            kvCacheUtilThreshold: k.saturationKvUtil,
          },
        },
      ],
      flowControl: {
        defaultRequestTTL: k.requestTtl,
        saturationDetector: { pluginRef: 'pool-saturation' },
      },
      schedulingProfiles: $.sessionAffinityProfiles,
    },

    // recipes/pd/epp/epp-sticky-approx.values.yaml: prefix-cache affinity from an approximate
    // index sized to keep a session on its pod for the whole run (autoTune off; with autoTune the
    // index is sized from the engine's block_size / num_gpu_blocks and forgets a session before
    // its next turn arrives). Validated on pd-0929 2P1D c64 (run 24, 190.5k tok/s).
    'sticky-approx':: function(k) {
      plugins: $.pdCorePlugins + [
        {
          type: 'approx-prefix-cache-producer',
          parameters: {
            autoTune: false,
            blockSizeTokens: k.approxBlockSizeTokens,
            maxPrefixTokensToMatch: k.approxMaxPrefixTokens,
            lruCapacityPerServer: k.approxLruCapacity,
          },
        },
        { type: 'inflight-load-producer' },
        {
          type: 'prefix-cache-affinity-filter',
          parameters: {
            peakPrefillThroughput: k.approxPeakPrefillThroughput,
            maxTTFTPenaltyMs: k.approxMaxTtftPenaltyMs,
          },
        },
        { type: 'token-load-scorer' },
        { type: 'active-request-scorer' },
        { type: 'max-score-picker' },
      ],
      schedulingProfiles: $.approxProfiles,
    },

    // Hybrid session-affinity + approximate prefix-cache scoring (validated at 4P3D c560 in
    // j-ef9c4379-20d8-452e-ab0b: 71.64% decode local HBM cache hit rate, 2.084M tok/s total
    // throughput, 3,395 ms mean TTFT). First turn of a session is placed by prefix-cache-scorer
    // (weight 8) + active-request-scorer (weight 1); subsequent turns are pinned to that decode
    // rank by session-affinity-decode.
    'sessaff-prefix':: function(k) {
      plugins: $.pdCorePlugins + [
        {
          type: 'approx-prefix-cache-producer',
          parameters: {
            autoTune: false,
            blockSizeTokens: k.approxBlockSizeTokens,
            maxPrefixTokensToMatch: k.approxMaxPrefixTokens,
            lruCapacityPerServer: k.approxLruCapacity,
          },
        },
        { type: 'inflight-load-producer' },
        {
          type: 'prefix-cache-affinity-filter',
          parameters: {
            peakPrefillThroughput: k.approxPeakPrefillThroughput,
            maxTTFTPenaltyMs: k.approxMaxTtftPenaltyMs,
          },
        },
        {
          type: 'session-affinity-filter',
          name: 'session-affinity-decode',
          parameters: {
            strategy: 'session_id',
            sessionIdConfig: $.sessionIdConfig(k),
          },
        },
        { type: 'token-load-scorer', parameters: { queueThresholdTokens: 67108864 } },
        { type: 'prefix-cache-scorer' },
        { type: 'active-request-scorer' },
        { type: 'max-score-picker' },
      ],
      schedulingProfiles: [
        {
          name: 'prefill',
          plugins: [
            { pluginRef: 'prefill-filter' },
            { pluginRef: 'prefix-cache-affinity-filter' },
            { pluginRef: 'token-load-scorer' },
            { pluginRef: 'max-score-picker' },
          ],
        },
        {
          name: 'decode',
          plugins: [
            { pluginRef: 'decode-filter' },
            { pluginRef: 'session-affinity-decode' },
            { pluginRef: 'prefix-cache-scorer', weight: k.decodePrefixWeight },
            { pluginRef: 'active-request-scorer', weight: k.decodeLoadWeight },
            { pluginRef: 'max-score-picker' },
          ],
        },
      ],
    },

    // Multi-port DP decode session affinity with fail-open queue/KV spill before
    // session-affinity-decode (validated on Band A 4P3D DP4xTP2 cap=28 c=600 in
    // j-2c206e73-a62e-497b-ba5b: 232.3 Mtok/$ vs 210.8 Mtok/$ toy proxy, 66.62% decode local
    // HBM cache hit rate). When the pinned decode DP rank has WaitingQueueSize <
    // decodeSpillQueueDepth and KVCacheUsagePercent < decodeSpillKvUtil, session-affinity-decode
    // keeps the session (and subagents) on that warm rank; when the rank saturates while another
    // rank has headroom, decode-spill removes the saturated rank before session-affinity-decode
    // runs and places the spilled turn (as well as cold first turns) using balanced
    // prefix/active/running/kv scorers.
    'sessaff-spill':: function(k)
      local prefixWeight = if k.decodePrefixWeight != 8 then k.decodePrefixWeight else 2;
      local activeWeight = if k.decodeLoadWeight != 1 then k.decodeLoadWeight else 3;
      local runningWeight = if k.decodeRunningWeight > 0 then k.decodeRunningWeight else 2;
      local queueWeight = k.decodeQueueWeight;
      local kvWeight = if k.decodeKvWeight > 0 then k.decodeKvWeight else 1;
      {
        plugins: $.pdCorePlugins + [
          {
            type: 'approx-prefix-cache-producer',
            parameters: {
              autoTune: false,
              blockSizeTokens: k.approxBlockSizeTokens,
              maxPrefixTokensToMatch: k.approxMaxPrefixTokens,
              lruCapacityPerServer: k.approxLruCapacity,
            },
          },
          { type: 'inflight-load-producer' },
          {
            type: 'prefix-cache-affinity-filter',
            parameters: {
              peakPrefillThroughput: k.approxPeakPrefillThroughput,
              maxTTFTPenaltyMs: k.approxMaxTtftPenaltyMs,
            },
          },
          {
            type: 'utilization-detector',
            name: 'utilization-detector',
            parameters: {
              queueDepthThreshold: k.prefillSpillQueueDepth,
              kvCacheUtilThreshold: k.prefillSpillKvUtil,
            },
          },
          {
            type: 'utilization-detector',
            name: 'decode-spill',
            parameters: {
              queueDepthThreshold: k.decodeSpillQueueDepth,
              kvCacheUtilThreshold: k.decodeSpillKvUtil,
            },
          },
          {
            type: 'session-affinity-filter',
            name: 'session-affinity-decode',
            parameters: {
              strategy: 'session_id',
              sessionIdConfig: $.sessionIdConfig(k),
            },
          },
          { type: 'token-load-scorer', parameters: { queueThresholdTokens: 67108864 } },
          { type: 'prefix-cache-scorer' },
          { type: 'active-request-scorer' },
          { type: 'running-requests-size-scorer' },
        ] + (if queueWeight > 0 then [{ type: 'queue-scorer' }] else [])
        + (if kvWeight > 0 then [{ type: 'kv-cache-utilization-scorer' }] else [])
        + [
          { type: 'max-score-picker' },
        ],
        schedulingProfiles: [
          {
            name: 'prefill',
            plugins: [
              { pluginRef: 'prefill-filter' },
              { pluginRef: 'prefix-cache-affinity-filter' },
              { pluginRef: 'token-load-scorer' },
              { pluginRef: 'max-score-picker' },
            ],
          },
          {
            name: 'decode',
            plugins: [
              { pluginRef: 'decode-filter' },
              { pluginRef: 'decode-spill' },
              { pluginRef: 'session-affinity-decode' },
              { pluginRef: 'prefix-cache-scorer', weight: prefixWeight },
              { pluginRef: 'active-request-scorer', weight: activeWeight },
              { pluginRef: 'running-requests-size-scorer', weight: runningWeight },
            ] + (if queueWeight > 0 then [{ pluginRef: 'queue-scorer', weight: queueWeight }] else [])
            + (if kvWeight > 0 then [{ pluginRef: 'kv-cache-utilization-scorer', weight: kvWeight }] else [])
            + [
              { pluginRef: 'max-score-picker' },
            ],
          },
        ],
      },

    // Soft prefix-cache + multi-signal load scoring on decode without a hard
    // session-affinity-filter (`pd-soft-affinity` / `sessaff-soft`). Designed for TP8 DCP4
    // points (Bands C through H, cap=28 down to cap=1) where client concurrency is 3x-17x total
    // decode running slots (`decode_pods * cap`). `approx-prefix-cache-producer` indexes prompt
    // blocks on both the chosen decode pod and prefill pod on every turn, so `prefix-cache-scorer`
    // provides soft session/subagent stickiness on decode while min-max normalized `queue-scorer`,
    // `running-requests-size-scorer`, in-flight `active-request-scorer`, and
    // `kv-cache-utilization-scorer` continuously spill requests away from slot-full or
    // queue-outlier decode pods (eliminating the 21%-58% slot-blocking penalty of hard
    // session-affinity-filter).
    'pd-soft-affinity':: function(k)
      local prefixWeight = if k.decodePrefixWeight != 8 then k.decodePrefixWeight else 3;
      local queueWeight = if k.decodeQueueWeight > 0 then k.decodeQueueWeight else 3;
      local runningWeight = if k.decodeRunningWeight > 0 then k.decodeRunningWeight else 2;
      local activeWeight = if k.decodeLoadWeight != 1 then k.decodeLoadWeight else 2;
      local kvWeight = if k.decodeKvWeight > 0 then k.decodeKvWeight else 1;
      {
        plugins: $.pdCorePlugins + [
          {
            type: 'approx-prefix-cache-producer',
            parameters: {
              autoTune: false,
              blockSizeTokens: k.approxBlockSizeTokens,
              maxPrefixTokensToMatch: k.approxMaxPrefixTokens,
              lruCapacityPerServer: k.approxLruCapacity,
            },
          },
          { type: 'inflight-load-producer' },
          {
            type: 'prefix-cache-affinity-filter',
            parameters: {
              peakPrefillThroughput: k.approxPeakPrefillThroughput,
              maxTTFTPenaltyMs: k.approxMaxTtftPenaltyMs,
            },
          },
          {
            type: 'utilization-detector',
            name: 'utilization-detector',
            parameters: {
              queueDepthThreshold: k.prefillSpillQueueDepth,
              kvCacheUtilThreshold: k.prefillSpillKvUtil,
            },
          },
          {
            type: 'utilization-detector',
            name: 'decode-spill',
            parameters: {
              queueDepthThreshold: k.decodeSpillQueueDepth,
              kvCacheUtilThreshold: k.decodeSpillKvUtil,
            },
          },
          { type: 'token-load-scorer', parameters: { queueThresholdTokens: 67108864 } },
          { type: 'prefix-cache-scorer' },
          { type: 'queue-scorer' },
          { type: 'running-requests-size-scorer' },
          { type: 'active-request-scorer' },
          { type: 'kv-cache-utilization-scorer' },
          { type: 'max-score-picker' },
        ],
        schedulingProfiles: [
          {
            name: 'prefill',
            plugins: [
              { pluginRef: 'prefill-filter' },
              { pluginRef: 'prefix-cache-affinity-filter' },
              { pluginRef: 'token-load-scorer' },
              { pluginRef: 'max-score-picker' },
            ],
          },
          {
            name: 'decode',
            plugins: [
              { pluginRef: 'decode-filter' },
              { pluginRef: 'decode-spill' },
              { pluginRef: 'prefix-cache-scorer', weight: prefixWeight },
              { pluginRef: 'queue-scorer', weight: queueWeight },
              { pluginRef: 'running-requests-size-scorer', weight: runningWeight },
              { pluginRef: 'active-request-scorer', weight: activeWeight },
              { pluginRef: 'kv-cache-utilization-scorer', weight: kvWeight },
              { pluginRef: 'max-score-picker' },
            ],
          },
        ],
      },

    'sessaff-soft':: function(k) $.presets['pd-soft-affinity'](k),

    // guides/pd-disaggregation/router/pd-disaggregation.values.yaml: the llm-d guide's P/D
    // configuration (autoTune on, default affinity threshold). The guide's peakPrefillThroughput
    // is an H200 figure; EPP_APPROX_PEAK_PREFILL_TPS carries the tpu7x measurement instead.
    'pd-default':: function(k) {
      plugins: $.pdCorePlugins + [
        { type: 'approx-prefix-cache-producer', parameters: { maxPrefixTokensToMatch: k.approxMaxPrefixTokens } },
        { type: 'inflight-load-producer' },
        { type: 'prefix-cache-affinity-filter', parameters: { peakPrefillThroughput: k.approxPeakPrefillThroughput } },
        { type: 'token-load-scorer' },
        { type: 'active-request-scorer' },
        { type: 'max-score-picker' },
      ],
      schedulingProfiles: $.approxProfiles,
    },

    // thunder-agent (ThunderAgent session admission control, arXiv 2602.13692) in the three slots
    // its README prescribes: scorer in each profile, flow-control saturation detector, fairness
    // policy. The README's Limitations: "Prefill/decode disaggregation is not supported: every
    // pod the flow controller reports enters one ledger, so a new session can be reserved onto a
    // prefill pod." The preset is here so the behaviour can be measured, not because it is
    // expected to be correct; it renders only when the caller acknowledges that.
    thunder:: function(k) {
      assert k.ackUnsupported : 'EPP_PROFILE=thunder: the thunder-agent README states that P/D disaggregation is not supported (one ledger over prefill and decode pods). Pass EPP_ACK_UNSUPPORTED=true to render it anyway.',
      featureGates: ['flowControl'],
      plugins: [
        { type: 'agent-identity', parameters: { additionalSessionHeaders: $.sessionHeaders } },
        {
          type: 'thunder-agent',
          name: 'thunder',
          parameters: {
            capacityTokens: k.thunderCapacityTokens,
            utilThreshold: k.thunderUtilThreshold,
            idleLeaseSeconds: k.thunderIdleLeaseSeconds,
            headWaitStarvationMs: k.thunderHeadWaitMs,
            evictionTtlSeconds: 3600,
          },
        },
      ] + $.pdCorePlugins + [
        { type: 'max-score-picker' },
      ],
      flowControl: {
        // No queue eviction: a held request is force-admitted by the starvation backstop
        // (headWaitStarvationMs) instead of being rejected with 429. Envoy's ext_proc
        // message_timeout (1000 s) is the hard ceiling on a hold.
        defaultRequestTTL: '0s',
        saturationDetector: { pluginRef: 'thunder' },
        defaultPriorityBand: { fairnessPolicyRef: 'thunder' },
      },
      schedulingProfiles: [
        { name: 'prefill', plugins: [{ pluginRef: 'prefill-filter' }, { pluginRef: 'thunder' }, { pluginRef: 'max-score-picker' }] },
        { name: 'decode', plugins: [{ pluginRef: 'decode-filter' }, { pluginRef: 'thunder' }, { pluginRef: 'max-score-picker' }] },
      ],
    },
  },

  profileNames:: std.objectFieldsAll($.presets) + ['custom'],

  // The file-discovery data layer: endpoints from the file the resolver maintains, reloaded on
  // every atomic replacement. Added to every configuration, presets and custom alike.
  withFileDiscovery(cfg):: cfg {
    plugins: [
      { type: 'file-discovery', name: 'jobset-endpoints', parameters: { path: $.endpointsPath, watchFile: true } },
    ] + super.plugins,
    dataLayer+: { discovery+: { endpoints: { pluginRef: 'jobset-endpoints' } } },
  },

  // eppConfig resolves profile -> preset (or the custom body), applies the merge patch, and adds
  // the discovery layer. `custom` and `patch` arrive as JSON strings from the variables.
  eppConfig(profile, k, customJson='', patchJson='')::
    local body =
      if profile == 'custom' then
        (if customJson == '' then error 'EPP_PROFILE=custom needs EPP_CONFIG_JSON (the EndpointPickerConfig body as JSON)'
         else std.parseJson(customJson))
      else if std.objectHasAll($.presets, profile) then $.presets[profile](k)
      else error 'EPP_PROFILE must be one of %s, got "%s"' % [std.join(', ', $.profileNames), profile];
    assert std.isObject(body) && std.objectHas(body, 'plugins') && std.objectHas(body, 'schedulingProfiles')
           : 'the EndpointPickerConfig body must be an object with plugins and schedulingProfiles';
    local patched = if patchJson != '' then std.mergePatch(body, std.parseJson(patchJson)) else body;
    { apiVersion: 'llm-d.ai/v1', kind: 'EndpointPickerConfig' } + $.withFileDiscovery(patched),

  eppConfigYaml(cfg):: std.manifestYamlDoc(cfg, indent_array_in_object=true, quote_keys=false),

  // ---------------------------------------------------------------------------
  // Envoy: the standalone chart's sidecar bootstrap (config/charts/llm-d-router-standalone
  // values.yaml, preset envoy) with the ext_proc cluster in plaintext, since the EPP runs with
  // --secure-serving=false. Listener :8081 -> ext_proc 127.0.0.1:9002 -> ORIGINAL_DST on the
  // x-gateway-destination-endpoint header the EPP sets. :19001/ready is Envoy's own readiness.
  // ---------------------------------------------------------------------------
  envoyAccessLogFormat:: '{"start_time":"%START_TIME%","method":"%REQ(:METHOD)%","path":"%REQ(X-ENVOY-ORIGINAL-PATH?:PATH)%","protocol":"%PROTOCOL%","response_code":"%RESPONSE_CODE%","response_flags":"%RESPONSE_FLAGS%","bytes_received":"%BYTES_RECEIVED%","bytes_sent":"%BYTES_SENT%","duration":"%DURATION%","upstream_host":"%UPSTREAM_HOST%","x_request_id":"%REQ(X-REQUEST-ID)%"}\n',

  envoyConfig(listenerPort=$.listenerPort, eppPort=$.eppGrpcPort, extProcMessageTimeout='1000s')::
    local fileAccessLog = 'type.googleapis.com/envoy.extensions.access_loggers.file.v3.FileAccessLog';
    local hcm = 'type.googleapis.com/envoy.extensions.filters.network.http_connection_manager.v3.HttpConnectionManager';
    local routerFilter = 'type.googleapis.com/envoy.extensions.filters.http.router.v3.Router';
    local stdoutLog = {
      name: 'envoy.access_loggers.file',
      typed_config: {
        '@type': fileAccessLog,
        path: '/dev/stdout',
        log_format: { text_format_source: { inline_string: $.envoyAccessLogFormat } },
      },
    };
    {
      admin: {
        address: { socket_address: { address: '127.0.0.1', port_value: 19000 } },
        access_log: [{ name: 'envoy.access_loggers.file', typed_config: { '@type': fileAccessLog, path: '/dev/null' } }],
      },
      static_resources: {
        listeners: [
          {
            name: 'envoy-proxy-ready-0.0.0.0-19001',
            address: { socket_address: { address: '0.0.0.0', port_value: 19001 } },
            filter_chains: [{
              filters: [{
                name: 'envoy.filters.network.http_connection_manager',
                typed_config: {
                  '@type': hcm,
                  stat_prefix: 'envoy-ready-http',
                  route_config: {
                    name: 'local_route',
                    virtual_hosts: [{
                      name: 'prometheus_stats',
                      domains: ['*'],
                      routes: [{ match: { prefix: '/stats/prometheus' }, route: { cluster: 'prometheus_stats' } }],
                    }],
                  },
                  http_filters: [
                    {
                      name: 'envoy.filters.http.health_check',
                      typed_config: {
                        '@type': 'type.googleapis.com/envoy.extensions.filters.http.health_check.v3.HealthCheck',
                        pass_through_mode: false,
                        headers: [{ name: ':path', string_match: { exact: '/ready' } }],
                      },
                    },
                    { name: 'envoy.filters.http.router', typed_config: { '@type': routerFilter } },
                  ],
                },
              }],
            }],
          },
          {
            name: 'vllm',
            address: { socket_address: { address: '0.0.0.0', port_value: listenerPort } },
            per_connection_buffer_limit_bytes: 32768,
            access_log: [stdoutLog { filter: { response_flag_filter: { flags: ['NR'] } } }],
            filter_chains: [{
              name: 'vllm',
              filters: [{
                name: 'envoy.filters.network.http_connection_manager',
                typed_config: {
                  '@type': hcm,
                  stat_prefix: 'http-%d' % listenerPort,
                  route_config: {
                    name: 'vllm',
                    virtual_hosts: [{
                      name: 'vllm-default',
                      domains: ['*'],
                      routes: [{
                        match: { prefix: '/' },
                        route: {
                          cluster: 'original_destination_cluster',
                          timeout: '86400s',
                          idle_timeout: '86400s',
                          upgrade_configs: [{ upgrade_type: 'websocket' }],
                        },
                        typed_per_filter_config: {
                          'envoy.filters.http.ext_proc': { '@type': 'type.googleapis.com/envoy.config.route.v3.FilterConfig', config: {} },
                        },
                      }],
                    }],
                  },
                  http_filters: [
                    {
                      name: 'envoy.filters.http.ext_proc',
                      typed_config: {
                        '@type': 'type.googleapis.com/envoy.extensions.filters.http.ext_proc.v3.ExternalProcessor',
                        failure_mode_allow: false,
                        grpc_service: {
                          envoy_grpc: { cluster_name: 'ext_proc', authority: 'localhost:%d' % eppPort },
                          timeout: '10s',
                        },
                        processing_mode: {
                          request_header_mode: 'SEND',
                          response_header_mode: 'SEND',
                          request_body_mode: 'FULL_DUPLEX_STREAMED',
                          response_body_mode: 'FULL_DUPLEX_STREAMED',
                          request_trailer_mode: 'SEND',
                          response_trailer_mode: 'SEND',
                        },
                        // The longest a request may sit in the EPP (flow-control queue included)
                        // before Envoy fails it; the flow-control TTL must stay below this.
                        message_timeout: extProcMessageTimeout,
                      },
                    },
                    { name: 'envoy.filters.http.router', typed_config: { '@type': routerFilter, suppress_envoy_headers: true } },
                  ],
                  http2_protocol_options: {
                    max_concurrent_streams: 100,
                    initial_stream_window_size: 65536,
                    initial_connection_window_size: 1048576,
                  },
                  use_remote_address: true,
                  normalize_path: true,
                  merge_slashes: true,
                  server_header_transformation: 'PASS_THROUGH',
                  common_http_protocol_options: { headers_with_underscores_action: 'REJECT_REQUEST' },
                  path_with_escaped_slashes_action: 'UNESCAPE_AND_REDIRECT',
                  access_log: [stdoutLog],
                },
              }],
            }],
          },
        ],
        clusters: [
          {
            name: 'prometheus_stats',
            type: 'STATIC',
            connect_timeout: '0.250s',
            load_assignment: {
              cluster_name: 'prometheus_stats',
              endpoints: [{ lb_endpoints: [{ endpoint: { address: { socket_address: { address: '127.0.0.1', port_value: 19000 } } } }] }],
            },
          },
          {
            name: 'original_destination_cluster',
            type: 'ORIGINAL_DST',
            connect_timeout: '1000s',
            lb_policy: 'CLUSTER_PROVIDED',
            circuit_breakers: { thresholds: [{ max_connections: 40000, max_pending_requests: 40000, max_requests: 40000 }] },
            original_dst_lb_config: { use_http_header: true, http_header_name: 'x-gateway-destination-endpoint' },
          },
          {
            name: 'ext_proc',
            type: 'STATIC',
            connect_timeout: '86400s',
            lb_policy: 'LEAST_REQUEST',
            circuit_breakers: { thresholds: [{ max_connections: 40000, max_pending_requests: 40000, max_requests: 40000, max_retries: 1024 }] },
            health_checks: [{
              timeout: '2s',
              interval: '10s',
              unhealthy_threshold: 3,
              healthy_threshold: 2,
              reuse_connection: true,
              grpc_health_check: { service_name: 'envoy.service.ext_proc.v3.ExternalProcessor' },
            }],
            typed_extension_protocol_options: {
              'envoy.extensions.upstreams.http.v3.HttpProtocolOptions': {
                '@type': 'type.googleapis.com/envoy.extensions.upstreams.http.v3.HttpProtocolOptions',
                explicit_http_config: { http2_protocol_options: { initial_stream_window_size: 65536, initial_connection_window_size: 1048576 } },
              },
            },
            load_assignment: {
              cluster_name: 'ext_proc',
              endpoints: [{
                locality: { region: 'ext_proc/e2e/0' },
                lb_endpoints: [{ endpoint: { address: { socket_address: { address: '127.0.0.1', port_value: eppPort } } }, load_balancing_weight: 1 }],
              }],
            },
          },
        ],
      },
    },

  // Keys such as "@type" need quoting in YAML, so every key is quoted here.
  envoyConfigYaml(cfg):: std.manifestYamlDoc(cfg, indent_array_in_object=true, quote_keys=true),

  // ---------------------------------------------------------------------------
  // Addressing
  // ---------------------------------------------------------------------------

  // The pod of replica i of a replicated job, as the JobSet's headless service names it:
  // <jobset>-<job>-<i>-0.<jobset>. `placeholder` is how the JobSet name is spelled at that
  // point: '${JS_NAME}' in a shell script, '{JS_NAME}' in the resolver (python str.format).
  jobsetHost(jobName, i, placeholder='${JS_NAME}'):: '%s-%s-%d-0.%s' % [placeholder, jobName, i, placeholder],
  jobsetHosts(jobName, replicas, placeholder='${JS_NAME}'):: [$.jobsetHost(jobName, i, placeholder) for i in std.range(0, replicas - 1)],

  // ---------------------------------------------------------------------------
  // The endpoint resolver: the only piece that moves at runtime. It is what replaces the pod
  // watch the EPP would otherwise need RBAC for.
  // ---------------------------------------------------------------------------
  resolverScript:: |||
    set -euo pipefail
    cat > /tmp/llmd_endpoint_resolver.py <<'PY'
    """Maintain the EPP's file-discovery endpoints file from the JobSet's pod DNS names.

    LLMD_ENDPOINT_GROUPS is a JSON list of {role, hosts, port, healthPort, health, dpSize?};
    each host is a DNS name template with {JS_NAME} for the JobSet name. Every
    LLMD_RESOLVE_INTERVAL_S seconds each host is resolved to its IPv4 address (the EPP
    accepts IPv4 literals only). When dpSize is 1 (the default), a pod is admitted once
    GET http://ip:healthPort<health> answers 2xx and registered as a single endpoint on
    port. When dpSize > 1 (--data-parallel-multi-port-external-lb), a pod is admitted once
    every rank port healthPort..healthPort+dpSize-1 answers 2xx and registered as dpSize
    endpoints (<pod>-rank-<r> at port+r with rankIndex=r). healthPort defaults to port, and
    differs from it where the registered port is a proxy in front of the engine (the decode
    routing sidecar). A pod stays admitted at that address until the address changes (then
    it must pass the health check again) and is kept through transient DNS failures. The
    file is replaced atomically (temp file + rename) and only when its content changed; the
    EPP reloads it on each replacement.
    """
    import json
    import os
    import socket
    import sys
    import time
    import urllib.request

    js_name = os.environ["JS_NAME"]
    groups = json.loads(os.environ["LLMD_ENDPOINT_GROUPS"])
    path = os.environ["LLMD_ENDPOINTS_FILE"]
    namespace = os.environ.get("NAMESPACE", "default")
    interval = float(os.environ.get("LLMD_RESOLVE_INTERVAL_S", "5"))


    def resolve(host):
        try:
            infos = socket.getaddrinfo(host, None, socket.AF_INET, socket.SOCK_STREAM)
        except socket.gaierror:
            return None
        ips = sorted({info[4][0] for info in infos})
        return ips[0] if ips else None


    def healthy(ip, port, health_path):
        try:
            with urllib.request.urlopen("http://%s:%s%s" % (ip, port, health_path), timeout=5) as r:
                return 200 <= r.status < 300
        except Exception:
            return False


    def healthy_all(ip, base_port, dp_size, health_path):
        return all(healthy(ip, base_port + r, health_path) for r in range(dp_size))


    admitted = {}  # (role, endpoint name) -> address it was admitted at
    last = None
    print("endpoint resolver: jobset=%s groups=%s file=%s" % (js_name, json.dumps(groups), path), flush=True)
    while True:
        entries = []
        for g in groups:
            port = int(g["port"])
            health_port = int(g.get("healthPort", port))
            health_path = g.get("health", "/health")
            dp_size = int(g.get("dpSize", 1))
            for template in g["hosts"]:
                host = template.format(JS_NAME=js_name)
                name = host.split(".")[0]
                key = (g["role"], name)
                ip = resolve(host)
                current = admitted.get(key)
                if ip is None:
                    if current is None:
                        continue
                    ip = current
                elif ip != current:
                    if not healthy_all(ip, health_port, dp_size, health_path):
                        if current is not None:
                            print("drop %s: address changed to %s and :%s%s not healthy" % (name, ip, health_port, health_path), flush=True)
                            admitted.pop(key, None)
                        continue
                    admitted[key] = ip
                    if dp_size > 1:
                        print("admit %s %s:%d-%d role=%s dp=%d (healthy on :%d-%d%s)" % (
                            name, ip, port, port + dp_size - 1, g["role"], dp_size,
                            health_port, health_port + dp_size - 1, health_path), flush=True)
                    else:
                        print("admit %s %s:%d role=%s (healthy on :%d%s)" % (name, ip, port, g["role"], health_port, health_path), flush=True)
                if dp_size > 1:
                    for r in range(dp_size):
                        entries.append({
                            "name": "%s-rank-%d" % (name, r),
                            "namespace": namespace,
                            "address": ip,
                            "port": str(port + r),
                            "rankIndex": r,
                            "labels": {"llm-d.ai/role": g["role"], "app": "vllm"},
                        })
                else:
                    entries.append({
                        "name": name,
                        "namespace": namespace,
                        "address": ip,
                        "port": str(port),
                        "labels": {"llm-d.ai/role": g["role"], "app": "vllm"},
                    })
        text = json.dumps({"endpoints": entries}, indent=2, sort_keys=True) + "\n"
        if text != last:
            tmp = path + ".tmp"
            with open(tmp, "w") as f:
                f.write(text)
            os.replace(tmp, path)
            last = text
            print("endpoints file updated: %d endpoint(s): %s" % (
                len(entries), ", ".join("%s=%s:%s" % (e["name"], e["address"], e["port"]) for e in entries)), flush=True)
        sys.stdout.flush()
        time.sleep(interval)
    PY
    exec python3 -u /tmp/llmd_endpoint_resolver.py
  |||,

  // ---------------------------------------------------------------------------
  // Containers and the router job
  // ---------------------------------------------------------------------------

  configVolume:: { name: $.configVolumeName, emptyDir: { medium: 'Memory' } },
  configMount(readOnly=true):: { name: $.configVolumeName, mountPath: $.configDir, readOnly: readOnly },

  // Writes the three files the other containers read. Env rather than ConfigMap because a CDK
  // recipe cannot create ConfigMaps; the configs show up in the rendered JobSet as env values.
  configInitContainer(eppConfig, envoyConfig=$.envoyConfig())::
    cdk.container(
      name='llm-d-config',
      image='busybox',
      shell='/bin/sh',
      script=|||
        set -e
        mkdir -p %(dir)s
        printf '%%s\n' "$LLMD_EPP_CONFIG" > %(epp)s
        printf '%%s\n' "$LLMD_ENVOY_CONFIG" > %(envoy)s
        printf '{"endpoints": []}\n' > %(endpoints)s
        echo "llm-d router config written to %(dir)s:"
        ls -l %(dir)s
        echo "--- %(epp)s ---"
        cat %(epp)s
      ||| % { dir: $.configDir, epp: $.eppConfigPath, envoy: $.envoyConfigPath, endpoints: $.endpointsPath },
      env={
        LLMD_EPP_CONFIG: $.eppConfigYaml(eppConfig),
        LLMD_ENVOY_CONFIG: $.envoyConfigYaml(envoyConfig),
      },
      volumeMounts=[$.configMount(readOnly=false)],
    ),

  // Distroless image: no shell, so this is a plain container spec rather than cdk.container.
  envoyContainer(image=$.defaultEnvoyImage, resources=null, listenerPort=$.listenerPort):: {
    name: 'envoy',
    image: image,
    imagePullPolicy: 'IfNotPresent',
    command: ['envoy'],
    // The base values of guides/recipes/router: warn-level logging and a bounded worker count
    // (Envoy would otherwise start one worker per host CPU).
    args: [
      '--service-node', 'envoy-sidecar',
      '--log-level', 'warn',
      '--concurrency', '8',
      '--drain-strategy', 'immediate',
      '--drain-time-s', '60',
      '-c', $.envoyConfigPath,
    ],
    env: cdk.envList({
      NS_NAME: { valueFrom: { fieldRef: { fieldPath: 'metadata.namespace' } } },
      POD_NAME: { valueFrom: { fieldRef: { fieldPath: 'metadata.name' } } },
    }),
    ports: [
      { name: 'http', containerPort: listenerPort, protocol: 'TCP' },
      { name: 'envoy-ready', containerPort: 19001, protocol: 'TCP' },
    ],
    [if resources != null then 'resources']: resources,
    volumeMounts: [$.configMount()],
  },

  // Also distroless. --secure-serving=false pairs with the plaintext ext_proc cluster above;
  // --health-checking=true registers the gRPC health service on the ext_proc port, which is
  // what the Envoy cluster's grpc_health_check probes (pkg/epp/server/runserver.go: the service
  // is only registered behind this flag, and the flag defaults to false). Without it Envoy
  // marks the EPP unhealthy and reaches it only through panic routing, which the standalone
  // guide (guides/no-kubernetes-deployment) calls out. --metrics-endpoint-auth=false lets the
  // bench read :9090/metrics without a TokenReview (which would need a ClusterRole);
  // --allow-experimental-plugins admits the Alpha plugins (session-affinity-filter,
  // agent-identity, thunder-agent). NAMESPACE is what the runner uses as the pool namespace in
  // file-discovery mode.
  eppContainer(image=$.defaultEppImage, logLevel=2, resources=null, poolName='cdk-llmd', extraArgs=[]):: {
    name: 'epp',
    image: image,
    imagePullPolicy: 'Always',
    args: [
      '--config-file=' + $.eppConfigPath,
      '--pool-name=' + poolName,
      '--zap-encoder=json',
      '--grpc-port=%d' % $.eppGrpcPort,
      '--grpc-health-port=%d' % $.eppHealthPort,
      '--metrics-port=%d' % $.eppMetricsPort,
      '--secure-serving=false',
      '--health-checking=true',
      '--metrics-endpoint-auth=false',
      '--allow-experimental-plugins=true',
      '--tracing=false',
      '--v=%d' % logLevel,
    ] + extraArgs,
    env: cdk.envList({
      NAMESPACE: { valueFrom: { fieldRef: { fieldPath: 'metadata.namespace' } } },
      POD_NAME: { valueFrom: { fieldRef: { fieldPath: 'metadata.name' } } },
    }),
    ports: [
      { name: 'grpc', containerPort: $.eppGrpcPort, protocol: 'TCP' },
      { name: 'grpc-health', containerPort: $.eppHealthPort, protocol: 'TCP' },
      { name: 'metrics', containerPort: $.eppMetricsPort, protocol: 'TCP' },
    ],
    [if resources != null then 'resources']: resources,
    volumeMounts: [$.configMount()],
  },

  // groups: [{ role, hosts (templates with {JS_NAME}), port, healthPort, health, dpSize? }].
  resolverContainer(groups, image=$.defaultResolverImage, intervalSeconds=5)::
    cdk.container(
      name='endpoint-resolver',
      image=image,
      script=$.resolverScript,
      env=cdk.jobSetNameEnv + {
        NAMESPACE: { valueFrom: { fieldRef: { fieldPath: 'metadata.namespace' } } },
        LLMD_ENDPOINT_GROUPS: std.manifestJsonMinified(groups),
        LLMD_ENDPOINTS_FILE: $.endpointsPath,
        LLMD_RESOLVE_INTERVAL_S: intervalSeconds,
      },
      resources={ requests: { cpu: '100m', memory: '128Mi' }, limits: { memory: '512Mi' } },
      volumeMounts=[$.configMount(readOnly=false)],
    ),

  // The Router as one replicated job: Envoy + EPP + resolver, CPU only (no nodeSelector, so it
  // lands beside the benchmark on the cpu pool). The pod template carries restartPolicy Never as
  // every CDK job does; a crashed EPP fails the job and the JobSet's failurePolicy restarts the
  // gang, which is also what happens when a model server dies.
  //
  // prefillPort / decodePort are what the EPP routes to and scrapes /metrics from; the
  // health ports are where the resolver reads readiness, and default to the same ports. They
  // differ on a decode pod behind the routing sidecar: the endpoint is the sidecar (:8000), whose
  // /health is unconditional, while readiness is the engine's own /health (decodeHealthPort =
  // the vLLM port). The sidecar forwards /metrics to the engine, so scraping the sidecar port is
  // fine; only the readiness gate has to bypass it.
  //
  // prefillDpSize / decodeDpSize (> 1 under vLLM --data-parallel-multi-port-external-lb) expand
  // each pod of that role into dpSize endpoints at port..port+dpSize-1 (health-checked across
  // healthPort..healthPort+dpSize-1) with rankIndex 0..dpSize-1. Omitted from LLMD_ENDPOINT_GROUPS
  // when 1 so single-port renders stay unchanged.
  routerJob(
    eppConfig,
    prefillHosts,
    decodeHosts,
    prefillPort,
    decodePort,
    prefillHealthPort=null,
    decodeHealthPort=null,
    prefillDpSize=1,
    decodeDpSize=1,
    name='router',
    eppImage=$.defaultEppImage,
    envoyImage=$.defaultEnvoyImage,
    resolverImage=$.defaultResolverImage,
    eppLogLevel=2,
    eppResources={ requests: { cpu: '2', memory: '4Gi' }, limits: { memory: '16Gi' } },
    envoyResources={ requests: { cpu: '1', memory: '2Gi' }, limits: { memory: '8Gi' } },
    resolveIntervalSeconds=5,
    eppExtraArgs=[],
  )::
    assert std.isNumber(prefillDpSize) && prefillDpSize >= 1 && std.floor(prefillDpSize) == prefillDpSize
           : 'routerJob: prefillDpSize must be a positive integer, got %s' % std.toString(prefillDpSize);
    assert std.isNumber(decodeDpSize) && decodeDpSize >= 1 && std.floor(decodeDpSize) == decodeDpSize
           : 'routerJob: decodeDpSize must be a positive integer, got %s' % std.toString(decodeDpSize);
    local orPort(health, port) = std.toString(if health != null then health else port);
    local groups = [
      {
        role: 'prefill',
        hosts: prefillHosts,
        port: std.toString(prefillPort),
        healthPort: orPort(prefillHealthPort, prefillPort),
        health: '/health',
        [if prefillDpSize > 1 then 'dpSize']: prefillDpSize,
      },
      {
        role: 'decode',
        hosts: decodeHosts,
        port: std.toString(decodePort),
        healthPort: orPort(decodeHealthPort, decodePort),
        health: '/health',
        [if decodeDpSize > 1 then 'dpSize']: decodeDpSize,
      },
    ];
    cdk.job(
      name=name,
      podSpec={ initContainers: [$.configInitContainer(eppConfig)] },
      volumes=[$.configVolume],
      containers=[
        $.envoyContainer(image=envoyImage, resources=envoyResources),
        $.eppContainer(image=eppImage, logLevel=eppLogLevel, resources=eppResources, extraArgs=eppExtraArgs),
        $.resolverContainer(groups, image=resolverImage, intervalSeconds=resolveIntervalSeconds),
      ],
    ),

  // The routing sidecar on a decode pod: receives the request from Envoy on :8000 with the EPP's
  // x-llm-d-prefiller-host-port header, runs the prefill on that pod (max_tokens=1, carrying the
  // kv_transfer_params handshake), then the decode on the local vLLM. --kv-connector=nixlv2 is
  // the handshake dialect TPURaidenConnector answers (pd-rc e2e, 2026-10-16). --model-server-port
  // is the local engine (the binary's default is 8200; cmd/pd-sidecar in llm-d-router) and
  // --secure-serving the current spelling of the TLS switch (--secure-proxy is its deprecated
  // alias). Every path other than the chat/completions ones is reverse-proxied to the engine
  // verbatim, /metrics included, so the EPP scrapes the engine through this port; GET /health is
  // answered by the sidecar itself with 200 regardless of the engine's state. A regular
  // container rather than a native sidecar: CDK pins the pod's restartPolicy and the pod lives
  // as long as the job anyway.
  //
  // prefillMaxRetries / prefillRetryBackoff: --prefill-max-retries and --prefill-retry-backoff
  // (pkg/sidecar/proxy/options.go). The sidecar sends the prefill request through an
  // httputil.ReverseProxy whose default error handler turns any transport failure (a connection
  // reset included) into a bodiless 502, and connector_nixlv2.go re-sends the request to the
  // same prefill pod on 502/503/504 up to this many times before failing the client request.
  // The binary's own default is 0 (no retry); 2 attempts 200 ms apart cover the keep-alive
  // reset described in the header without masking a prefill pod that is really down. 0
  // disables the retry and omits both flags.
  //
  // dataParallelSize (> 1 under vLLM --data-parallel-multi-port-external-lb): passes
  // --data-parallel-size=<N> so the sidecar listens on port..port+N-1 and forwards each rank r to
  // localhost:(modelServerPort+r) (pkg/sidecar/proxy/data_parallel.go). Omitted when 1.
  decodeSidecar(modelServerPort, image=$.defaultSidecarImage, port=$.sidecarPort, kvConnector='nixlv2', logLevel=1,
                prefillMaxRetries=2, prefillRetryBackoff='200ms', dataParallelSize=1):: {
    assert std.isNumber(prefillMaxRetries) && prefillMaxRetries >= 0 && std.floor(prefillMaxRetries) == prefillMaxRetries
           : 'decodeSidecar: prefillMaxRetries must be a non-negative integer, got %s' % std.toString(prefillMaxRetries),
    assert std.isNumber(dataParallelSize) && dataParallelSize >= 1 && std.floor(dataParallelSize) == dataParallelSize
           : 'decodeSidecar: dataParallelSize must be a positive integer, got %s' % std.toString(dataParallelSize),
    name: 'routing-proxy',
    image: image,
    imagePullPolicy: 'Always',
    args: [
      '--port=%d' % port,
      '--model-server-port=%d' % modelServerPort,
      '--kv-connector=' + kvConnector,
      '--secure-serving=false',
      '--zap-log-level=%d' % logLevel,
    ] + (if prefillMaxRetries > 0 then [
      '--prefill-max-retries=%d' % prefillMaxRetries,
      '--prefill-retry-backoff=' + prefillRetryBackoff,
    ] else []) + (if dataParallelSize > 1 then [
      '--data-parallel-size=%d' % dataParallelSize,
    ] else []),
    ports: [
      {
        name: if r == 0 then 'sidecar' else 'sidecar-dp-%d' % r,
        containerPort: port + r,
        protocol: 'TCP',
      }
      for r in std.range(0, dataParallelSize - 1)
    ],
    resources: { requests: { cpu: '1', memory: '1Gi' }, limits: { memory: '4Gi' } },
    securityContext: { allowPrivilegeEscalation: false, runAsNonRoot: true },
  },

  // ---------------------------------------------------------------------------
  // Benchmark-side shell helpers
  // ---------------------------------------------------------------------------

  // vllm_metric NAME [prefill|decode]: one vLLM counter summed over all label sets (DP exposes
  // one series per engine) and over every pod of the role. The role's host:port list is in
  // PREFILL_METRICS_ENDPOINTS / DECODE_METRICS_ENDPOINTS (space separated). Never aborts the
  // run: an unreachable pod or an absent metric contributes 0.
  benchMetricsFns:: |||
    metrics_endpoints() {
      case "${1:-prefill}" in
        decode) printf '%s' "${DECODE_METRICS_ENDPOINTS:-}" ;;
        *)      printf '%s' "${PREFILL_METRICS_ENDPOINTS:-}" ;;
      esac
    }

    vllm_metric() {
      local name="$1" group="${2:-prefill}" ep v total=0
      for ep in $(metrics_endpoints "$group"); do
        v=$(curl -sf -m 20 "http://${ep}/metrics" 2>/dev/null | awk -v n="vllm:${name}" \
          '{k=$1; sub(/\{.*/, "", k); if (k==n) s+=$NF} END {printf "%.0f", s+0}') || v=""
        case "$v" in ''|*[!0-9]*) v=0 ;; esac
        total=$(( total + v ))
      done
      echo "$total"
    }

    vllm_metric_ms() {
      local name="$1" group="${2:-prefill}" ep v total=0
      for ep in $(metrics_endpoints "$group"); do
        v=$(curl -sf -m 20 "http://${ep}/metrics" 2>/dev/null | awk -v n="vllm:${name}" \
          '{k=$1; sub(/\{.*/, "", k); if (k==n) s+=$NF} END {printf "%.0f", (s+0)*1000}') || v=""
        case "$v" in ''|*[!0-9]*) v=0 ;; esac
        total=$(( total + v ))
      done
      echo "$total"
    }
  |||,

  // epp_metrics_snapshot TAG saves the EPP's /metrics to ${PARENT_RESULT_DIR}/epp-metrics-TAG.prom;
  // epp_metrics_report CONC prints the per-level deltas of the flow-control, thunder-agent,
  // program-aware and request counters, which is how a run shows whether the gate engaged
  // (e.g. flow_control_requests_total{outcome="EvictedTTL"}, thunder_agent_pauses_total).
  // Needs EPP_METRICS_URL. Both are best effort, and both run under the bench's
  // `set -ueo pipefail`: one `local` per assignment, since `local a="$1" b="$a"` expands $a
  // before either is assigned and trips set -u.
  eppMetricsFns:: |||
    epp_metrics_snapshot() {
      local tag="$1"
      local out="${PARENT_RESULT_DIR}/epp-metrics-${tag}.prom"
      if curl -sf -m 20 "${EPP_METRICS_URL}" > "$out" 2>/dev/null; then
        echo "EPP metrics snapshot (${tag}): $(wc -l < "$out") lines -> $out"
      else
        echo "WARNING: EPP metrics scrape failed (${tag}): ${EPP_METRICS_URL}"
        : > "$out"
      fi
    }

    epp_metrics_report() {
      local conc="$1"
      python3 - "$conc" "${PARENT_RESULT_DIR}/epp-metrics-start.prom" "${PARENT_RESULT_DIR}/epp-metrics-end.prom" <<'PY' || true
    import re, sys
    conc, start, end = sys.argv[1], sys.argv[2], sys.argv[3]
    # The names this EPP build (llm-d-router main) exports: request/error totals, the primary
    # profile's per-endpoint scheduling attempts (the decode distribution), the P/D decision
    # counter, and the flow-control / thunder-agent / program-aware families when their presets
    # are on. The inference_extension_* / inference_pool_* names are the upstream GIE spellings,
    # kept for an EPP image built from it. j-3c5be62f-9524-4249-8f64 reported 0 series with the
    # llm_d_epp_request_* names missing.
    keep = re.compile(r"^(llm_d_epp_(request_total|request_error_total|scheduler_attempts_total|disagg_decision_total|flow_control|thunder_agent|program_aware)|inference_extension_request_(total|error_total)|inference_pool_)")

    def load(p):
        out = {}
        try:
            for line in open(p):
                if line.startswith("#") or not line.strip():
                    continue
                key, _, val = line.rpartition(" ")
                if not keep.match(key):
                    continue
                try:
                    out[key] = float(val)
                except ValueError:
                    pass
        except OSError:
            pass
        return out

    a, b = load(start), load(end)
    deltas, gauges = [], []
    for key in sorted(set(a) | set(b)):
        name = key.split("{", 1)[0]
        # Histogram buckets repeat the _count/_sum information per boundary and would crowd
        # out the counters this report exists for.
        if name.endswith("_bucket"):
            continue
        if name.endswith("_total") or name.endswith("_count") or name.endswith("_sum"):
            d = b.get(key, 0.0) - a.get(key, 0.0)
            if d:
                deltas.append("%s delta=%g" % (key, d))
        elif key in b:
            gauges.append("%s end=%g" % (key, b[key]))
    rows = deltas + gauges
    print("EPP c%s: %d series of interest (%d counters moved)" % (conc, len(rows), len(deltas)))
    for r in rows[:80]:
        print("EPP c%s: %s" % (conc, r))
    PY
    }
  |||,
}

