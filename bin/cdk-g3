def _now_utc() -> datetime.datetime:
  return datetime.datetime.now(datetime.timezone.utc)


def _now_pt_iso() -> str:
  return datetime.datetime.now(PT_TZ).isoformat()


def _stamp_utc(dt: Optional[datetime.datetime] = None) -> str:
  d = dt or _now_utc()
  return d.astimezone(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def _new_job_id() -> str:
  """Generate a 4-group job ID matching `r'\\bj-[0-9a-f]{8}(?:-[0-9a-f]{4}){3}\\b'`."""
  raw = uuid.uuid4().hex
  return f"j-{raw[0:8]}-{raw[8:12]}-{raw[12:16]}-{raw[16:20]}"


def _user_spellings(user: str) -> set[str]:
  bare = (user or "").split("_")[0].strip()
  if not bare:
    return {user} - {""}
  return {user, bare, f"{bare}_google_com"}


@contextmanager
def _file_lock(lock_path: Path):
  lock_path.parent.mkdir(parents=True, exist_ok=True)
  fd = os.open(str(lock_path), os.O_CREAT | os.O_RDWR, 0o644)
  try:
    fcntl.flock(fd, fcntl.LOCK_EX)
    yield
  finally:
    try:
      fcntl.flock(fd, fcntl.LOCK_UN)
    finally:
      os.close(fd)


def _atomic_write_bytes_unlocked(path: Path, data: bytes) -> None:
  path.parent.mkdir(parents=True, exist_ok=True)
  if path.is_file() and path.suffix == ".json":
    bak_path = path.with_suffix(path.suffix + ".bak")
    try:
      shutil.copyfile(path, bak_path)
    except OSError:
      pass
  fd, tmp_name = tempfile.mkstemp(
      prefix=f".{path.name}.",
      suffix=".tmp",
      dir=str(path.parent),
  )
  try:
    with os.fdopen(fd, "wb") as fh:
      fh.write(data)
      fh.flush()
      os.fsync(fh.fileno())
    os.replace(tmp_name, str(path))
  finally:
    if os.path.exists(tmp_name):
      try:
        os.unlink(tmp_name)
      except OSError:
        pass


def _atomic_write_bytes(path: Path, data: bytes) -> None:
  path.parent.mkdir(parents=True, exist_ok=True)
  lock_path = path.with_suffix(path.suffix + ".lock")
  with _file_lock(lock_path):
    _atomic_write_bytes_unlocked(path, data)


def _atomic_write_json(path: Path, payload: Any) -> None:
  text = json.dumps(payload, indent=2, sort_keys=True) + "\n"
  _atomic_write_bytes(path, text.encode("utf-8"))


def _read_json_with_bak_recovery(path: Path) -> Any:
  lock_path = path.with_suffix(path.suffix + ".lock")
  bak_path = path.with_suffix(path.suffix + ".bak")
  with _file_lock(lock_path):
    try:
      return json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
      if bak_path.is_file():
        recovered = json.loads(bak_path.read_text(encoding="utf-8"))
        _atomic_write_bytes_unlocked(
            path,
            (json.dumps(recovered, indent=2, sort_keys=True) + "\n").encode(
                "utf-8"
            ),
        )
        return recovered
      raise exc


class StorageBackend:
  """Unified storage abstraction over `gs://...` and local filesystem paths."""

  def __init__(self, uri: str):
    raw = (uri or "").strip().rstrip("/")
    if not raw:
      raise ValueError(
          "Storage URI is empty. Set CDK_G3_STORAGE_URI,"
          " PERFKIT_CLUSTER_BUCKET, or AMPLIO_GCS_ROOT."
      )
    self.uri = raw
    self.is_gcs = raw.startswith("gs://")
    if not self.is_gcs:
      local_str = raw[len("file://") :] if raw.startswith("file://") else raw
      self.root = Path(local_str).expanduser().resolve()
      self.root.mkdir(parents=True, exist_ok=True)
    else:
      self.root = Path("/nonexistent")

  def _local_path(self, rel_path: str) -> Path:
    rel = rel_path.lstrip("/")
    return self.root / rel

  def _gcs_uri(self, rel_path: str) -> str:
    rel = rel_path.lstrip("/")
    return f"{self.uri}/{rel}" if rel else self.uri

  def exists(self, rel_path: str) -> bool:
    if not self.is_gcs:
      return self._local_path(rel_path).exists()
    r = subprocess.run(
        ["gsutil", "-q", "stat", self._gcs_uri(rel_path)],
        capture_output=True,
        timeout=120,
        check=False,
    )
    return r.returncode == 0

  def read_bytes(self, rel_path: str) -> bytes:
    if not self.is_gcs:
      p = self._local_path(rel_path)
      if not p.is_file():
        raise FileNotFoundError(f"Object not found: {p}")
      return p.read_bytes()
    uri = self._gcs_uri(rel_path)
    r = subprocess.run(
        ["gsutil", "cat", uri],
        capture_output=True,
        timeout=180,
        check=False,
    )
    if r.returncode != 0:
      raise FileNotFoundError(
          f"gsutil cat {uri} failed ({r.returncode}): "
          f"{r.stderr.decode(errors='replace').strip()}"
      )
    return r.stdout

  def read_json(self, rel_path: str) -> Any:
    if not self.is_gcs:
      return _read_json_with_bak_recovery(self._local_path(rel_path))
    return json.loads(self.read_bytes(rel_path).decode("utf-8"))

  def write_bytes(
      self, rel_path: str, data: bytes, *, if_not_exists: bool = False
  ) -> bool:
    if not self.is_gcs:
      p = self._local_path(rel_path)
      if if_not_exists:
        p.parent.mkdir(parents=True, exist_ok=True)
        lock_path = p.with_suffix(p.suffix + ".lock")
        with _file_lock(lock_path):
          if p.exists():
            return False
          _atomic_write_bytes_unlocked(p, data)
          return True
      _atomic_write_bytes(p, data)
      return True

    uri = self._gcs_uri(rel_path)
    with tempfile.TemporaryDirectory(prefix="cdk-g3-gs-") as tmp:
      f = Path(tmp) / Path(rel_path).name
      f.write_bytes(data)
      cmd = ["gsutil", "-q", "cp"]
      if if_not_exists:
        cmd.append("-n")
      cmd.extend([str(f), uri])
      r = subprocess.run(cmd, capture_output=True, timeout=300, check=False)
      if r.returncode != 0:
        raise RuntimeError(
            f"gsutil cp to {uri} failed ({r.returncode}): "
            f"{r.stderr.decode(errors='replace').strip()}"
        )
      if if_not_exists and b"Skipping existing" in (r.stderr + r.stdout):
        return False
      return True

  def write_json(
      self, rel_path: str, payload: Any, *, if_not_exists: bool = False
  ) -> bool:
    text = json.dumps(payload, indent=2, sort_keys=True) + "\n"
    return self.write_bytes(
        rel_path, text.encode("utf-8"), if_not_exists=if_not_exists
    )

  def list_rel_paths(self, prefix: str) -> List[str]:
    clean_prefix = prefix.strip("/")
    if not self.is_gcs:
      base = self._local_path(clean_prefix)
      if not base.exists():
        return []
      if base.is_file():
        return [clean_prefix]
      return sorted(
          str(p.relative_to(self.root))
          for p in base.rglob("*")
          if (
              p.is_file()
              and not p.name.endswith(".lock")
              and not p.name.endswith(".tmp")
              and not p.name.endswith(".bak")
          )
      )
    uri_prefix = f"{self._gcs_uri(clean_prefix).rstrip('/')}/**"
    r = subprocess.run(
        ["gsutil", "ls", uri_prefix],
        capture_output=True,
        timeout=180,
        check=False,
    )
    if r.returncode != 0:
      if b"matched no objects" in (
          r.stderr + r.stdout
      ) or b"One or more URLs matched no objects" in (r.stderr + r.stdout):
        return []
      raise RuntimeError(
          f"gsutil ls {uri_prefix} failed ({r.returncode}): "
          f"{r.stderr.decode(errors='replace').strip()}"
      )
    out = []
    base_uri = self.uri.rstrip("/") + "/"
    for line in r.stdout.decode(errors="replace").splitlines():
      line = line.strip()
      if line.startswith(base_uri) and not line.endswith("/"):
        out.append(line[len(base_uri) :])
    return sorted(out)


def resolve_storage_uri(
    explicit_uri: Optional[str] = None,
    env: Optional[Dict[str, str]] = None,
    *,
    use_shared_bucket: bool = False,
) -> str:
  env_map = os.environ if env is None else env
  if explicit_uri and explicit_uri.strip():
    return explicit_uri.strip().rstrip("/")
  for key in ("CDK_G3_STORAGE_URI", "PERFKIT_CLUSTER_BUCKET"):
    val = env_map.get(key, "").strip().rstrip("/")
    if val:
      if key == "PERFKIT_CLUSTER_BUCKET":
        return f"{val}/_cdk_g3"
      return val
  gcs_root = env_map.get("AMPLIO_GCS_ROOT", "").strip().rstrip("/")
  if gcs_root:
    return f"{gcs_root}/perfkit-cluster/_cdk_g3"
  if use_shared_bucket or env_map.get(
      "CDK_G3_USE_SHARED_BUCKET", ""
  ).strip().lower() in ("1", "true", "yes"):
    return DEFAULT_SHARED_GCS_STORAGE_URI
  default_local = Path(env_map.get("TMPDIR", "/tmp")) / "cdk_g3_default_store"
  return str(default_local)


def parse_values_yml(yaml_text: str) -> Dict[str, Any]:
  """Extract job metadata, env vars, topology, image, and POD_SCRIPT from values.yml."""
  name_m = re.search(r"^\s*name:\s*([^\s#]+)", yaml_text, re.M)
  job_name = (
      json.loads(name_m.group(1))
      if (name_m and name_m.group(1).startswith('"'))
      else (name_m.group(1) if name_m else "job")
  )

  rep_m = re.search(r"replicatedJobs:\s*\n\s*-\s*name:\s*([^\s#]+)", yaml_text)
  replicated_job = "scorer"
  if rep_m:
    raw_rep = rep_m.group(1).strip()
    replicated_job = json.loads(raw_rep) if raw_rep.startswith('"') else raw_rep

  accel_m = re.search(
      r"cloud\.google\.com/gke-tpu-accelerator:\s*([^\s#]+)", yaml_text
  )
  accelerator = "tpu7x"
  if accel_m:
    raw_acc = accel_m.group(1).strip()
    accelerator = json.loads(raw_acc) if raw_acc.startswith('"') else raw_acc

  topo_m = re.search(
      r"cloud\.google\.com/gke-tpu-topology:\s*([^\s#]+)", yaml_text
  )
  topology = "2x2x1"
  if topo_m:
    raw_topo = topo_m.group(1).strip()
    topology = json.loads(raw_topo) if raw_topo.startswith('"') else raw_topo

  img_m = re.search(r"^\s*image:\s*([^\s#]+)", yaml_text, re.M)
  image = ""
  if img_m:
    raw_img = img_m.group(1).strip()
    image = json.loads(raw_img) if raw_img.startswith('"') else raw_img

  env_vars: Dict[str, str] = {}
  for m in re.finditer(
      r"^\s*-\s*name:\s*([A-Za-z_][A-Za-z0-9_]*)\s*\n\s*value:\s*(.+)$",
      yaml_text,
      re.M,
  ):
    k = m.group(1).strip()
    v_raw = m.group(2).strip()
    if v_raw.startswith('"') and v_raw.endswith('"'):
      try:
        v = str(json.loads(v_raw))
      except ValueError:
        v = v_raw[1:-1]
    elif v_raw.startswith("'") and v_raw.endswith("'"):
      v = v_raw[1:-1]
    else:
      v = v_raw
    env_vars[k] = v

  script_lines: List[str] = []
  args_m = re.search(r"args:\s*\n\s*-\s*\|\s*\n((?:[ \t]+.*\n?)*)", yaml_text)
  if args_m:
    block = args_m.group(1)
    raw_lines = block.splitlines()
    non_empty_indents = [
        len(line) - len(line.lstrip(" ")) for line in raw_lines if line.strip()
    ]
    min_indent = min(non_empty_indents) if non_empty_indents else 0
    script_lines = [
        line[min_indent:] if len(line) >= min_indent else line.lstrip()
        for line in raw_lines
    ]
  pod_script = "\n".join(script_lines).strip()

  return {
      "job_name": job_name,
      "replicated_job": replicated_job,
      "accelerator": accelerator,
      "topology": topology,
      "image": image,
      "env": env_vars,
      "pod_script": pod_script,
  }


def format_desc_yaml(meta: Dict[str, Any]) -> str:
  """Render YAML text compatible with `perfkit.cluster.parse_desc()`."""
  job_id = meta["id"]
  user = meta.get("user") or "jfy"
  recipe = meta.get("recipe") or "job"
  state = meta.get("state") or "Pending"
  job_status = meta.get("job_status") or "Pending"
  rep_job = meta.get("replicated_job") or "scorer"
  pods = meta.get("pods") or []
  xid = str(meta.get("xid") or "").strip()

  lines = [
      f"id: {job_id}",
      f"user: {user}",
      f"recipe: {recipe}",
      f"state: {state}",
      f"job_status: {job_status}",
  ]
  if xid:
    lines.append(f"xid: {xid}")
  lines.extend([
      "jobs:",
      f"  - name: {job_id}-{rep_job}-0",
  ])
  if not pods:
    lines.append("    pods: []")
  else:
    lines.append("    pods:")
    for p in pods:
      p_name = p["name"]
      p_status = p.get("status") or job_status
      p_created = p.get("created") or meta.get("create_time") or _stamp_utc()
      lines.extend([
          f"      - name: {p_name}",
          f"        status: {p_status}",
          "        k8s_events:",
          "          - reason: Created",
          f"            message: 'Created pod: {p_name}'",
          f"            first_seen: '{p_created}'",
      ])
  return "\n".join(lines) + "\n"


def build_cluster_usage_nodes(
    store: StorageBackend,
    *,
    singlehost_slots: int = 8,
    multihost_slots: int = 4,
    accelerator: str = "tpu7x",
) -> List[Dict[str, Any]]:
  """Construct `cdk usage -o json` node list reflecting active jobs in the store."""
  active_single: List[Dict[str, str]] = []
  active_multi: List[Dict[str, str]] = []
  for rel in store.list_rel_paths("jobs"):
    if not rel.endswith("/meta.json"):
      continue
    try:
      meta = store.read_json(rel)
    except Exception:
      continue
    if meta.get("job_status") in ("Running", "Pending") and meta.get(
        "active", True
    ):
      entry = {
          "user": str(meta.get("user") or "jfy"),
          "job_id": str(meta.get("id") or ""),
      }
      if str(meta.get("topology") or "2x2x1") == "2x2x1":
        active_single.append(entry)
      else:
        active_multi.append(entry)

  nodes: List[Dict[str, Any]] = []
  for i in range(max(1, singlehost_slots)):
    pods = [active_single[i]] if i < len(active_single) else []
    nodes.append({
        "name": f"borg-{accelerator}-singlehost-{i}",
        "node_pool": f"{accelerator}-singlehost-pool",
        "topology": "cloud.google.com/gke-tpu-topology=2x2x1",
        "status": "Ready",
        "pods": pods,
    })
  for i in range(max(1, multihost_slots)):
    pods = [active_multi[i]] if i < len(active_multi) else []
    nodes.append({
        "name": f"borg-{accelerator}-multihost-{i}",
        "node_pool": f"{accelerator}-multihost-pool",
        "topology": "cloud.google.com/gke-tpu-topology=2x2x2",
        "status": "Ready",
        "pods": pods,
    })
  return nodes


def parse_topology_prefix_and_shape(
    topology: str, accelerator: str = "tpu7x"
) -> Tuple[str, str, str]:
  """Parse a topology string into `(chip_prefix, geometry_shape, canonical_tpu_topology)`."""
  raw = (topology or "").strip()
  acc = (accelerator or "tpu7x").strip().lower()
  if not raw:
    raw = "2x2x1"
  low = raw.lower()
  if low == "v7x_1chip":
    return "gf", "1x1x1", "gf=1x1x1"
  if low == "v7x_1host":
    return "gf", "2x2x1", "gf=2x2x1"
  if low == "v7x_2host":
    return "gf", "2x2x2", "gf=2x2x2"

  for sep in ("=", ":"):
    if sep in raw:
      pref_raw, shape_raw = raw.split(sep, 1)
      pref = pref_raw.strip().lower()
      shape = shape_raw.strip()
      if pref in GHOSTFISH_TOPOLOGY_PREFIXES:
        return "gf", shape, f"gf={shape}"
      return pref, shape, f"{pref}={shape}"

  if acc in GHOSTFISH_TOPOLOGY_PREFIXES or not acc:
    return "gf", raw, f"gf={raw}"
  return acc, raw, f"{acc}={raw}"


def is_ghostfish_topology(topology: str, accelerator: str = "tpu7x") -> bool:
  """Return True if `topology` targets Ghostfish (`gf` / `ghostfish` / `tpu7x`)."""
  pref, _, _ = parse_topology_prefix_and_shape(topology, accelerator)
  return pref in GHOSTFISH_TOPOLOGY_PREFIXES


def is_multihost_topology(topology: str, accelerator: str = "tpu7x") -> bool:
  """Return True if `topology` requires multi-host (> 4 chips on Ghostfish, e.g., `2x2x2`)."""
  pref, shape, _ = parse_topology_prefix_and_shape(topology, accelerator)
  if shape == "2x2x2" or (topology or "").strip().lower() == "v7x_2host":
    return True
  dims = [int(d) for d in shape.split("x") if d.isdigit()]
  if dims and pref == "gf":
    prod = 1
    for d in dims:
      prod *= d
    return prod > 4
  return False


def validate_minibench_command_and_spec(
    command: Optional[Sequence[str]] = None,
    *,
    topology: str = "gf=1x1x1",
    tpu_topology: Optional[str] = None,
    accelerator: str = "tpu7x",
    minibench_mode: str = "auto",
    reference_code: Optional[str] = None,
    custom_code: Optional[str] = None,
    input_generation_code: Optional[str] = None,
    kernel_item: str = "",
    kernelbench_profile_llo: bool = True,
    enable_percale: bool = True,
    generate_runtime_llo_report: bool = True,
    borg_alloc: str = f"group:{VALID_BORG_ALLOC_SUBSTR}",
    spec: Optional[Dict[str, Any]] = None,
) -> Dict[str, Any]:
  """Validate a Minibench backend job spec/command and enforce `TRAP36H`.

  Per
  `//depot/google3/learning/performance/agents/tools/minibench/g3doc/usage_guide.md:518-532`,
  MLCR (`mlcr_configs.py:24-64`) only has warm pools for `vlp`, `vlp1t`,
  `vlp2t`,
  `glp`, `pf`, and `vf`—it has NO Ghostfish (`gf` / `tpu7x`) slices, and passing
  `--mode=mlcr` with `gf` silently falls back to spinning up a slow self-owned
  Pathways cluster via `xm_pathways`.
  """
  if tpu_topology:
    topology = tpu_topology
  reference_code = reference_code or ""
  custom_code = custom_code or ""
  input_generation_code = input_generation_code or ""
  if spec is not None:
    topology = str(spec.get("tpu_topology") or spec.get("topology") or topology)
    accelerator = str(spec.get("accelerator") or accelerator)
    minibench_mode = str(
        spec.get("minibench_mode") or spec.get("mode") or minibench_mode
    )
    reference_code = str(spec.get("reference_code") or reference_code)
    custom_code = str(spec.get("custom_code") or custom_code)
    input_generation_code = str(
        spec.get("input_generation_code") or input_generation_code
    )
    kernel_item = str(spec.get("kernel_item") or kernel_item)
    if "kernelbench_profile_llo" in spec:
      kernelbench_profile_llo = bool(spec["kernelbench_profile_llo"])
    if "enable_percale" in spec:
      enable_percale = bool(spec["enable_percale"])
    if "generate_runtime_llo_report" in spec:
      generate_runtime_llo_report = bool(spec["generate_runtime_llo_report"])
    borg_alloc = str(spec.get("borg_alloc") or borg_alloc)
    if command is None and spec.get("command"):
      command = list(spec["command"])

  cmd_tokens = list(command or ())
  for tok in cmd_tokens:
    if tok.startswith("--tpu_topology="):
      topology = tok.split("=", 1)[1].strip()
    elif tok.startswith("--mode="):
      cmd_mode = tok.split("=", 1)[1].strip()
      if minibench_mode == "auto" and cmd_mode in ("mlcr", "mlcr_hermetic"):
        minibench_mode = "mlcr"

  mode_clean = (minibench_mode or "auto").strip().lower()
  if mode_clean == "mlcr_hermetic":
    mode_clean = "mlcr"
  if mode_clean not in SUPPORTED_MINIBENCH_MODES:
    raise ValueError(
        f"Unsupported minibench_mode={minibench_mode!r}; must be one of"
        f" {SUPPORTED_MINIBENCH_MODES}."
    )

  prefix, shape, canonical_topology = parse_topology_prefix_and_shape(
      topology, accelerator
  )
  is_gf = prefix in GHOSTFISH_TOPOLOGY_PREFIXES

  if mode_clean == "mlcr":
    if is_gf:
      raise ValueError(
          f"[{TRAP36H_MLCR_GHOSTFISH_SILENT_PATHWAYS_FALLBACK}] Explicit"
          " '--mode=mlcr' / minibench_mode='mlcr' is forbidden on Ghostfish"
          f" topology '{canonical_topology}' (input='{topology}'). Per"
          " //depot/google3/learning/performance/agents/tools/minibench/g3doc/usage_guide.md:518-532"
          " and mlcr_configs.py:24-64, MLCR warm pools only support"
          f" {MLCR_WARM_POOL_TOPOLOGY_PREFIXES} and have NO Ghostfish ('gf')"
          " slices; passing '--mode=mlcr' with 'gf' silently falls back to"
          " spinning up a slow self-owned Pathways cluster via xm_pathways."
          " Use '--minibench-mode=auto', '--minibench-mode=local_hermetic'"
          " (single-host Forge Ghostfish), or '--minibench-mode=xm_local' /"
          " '--minibench-mode=xm_pathways' (Borg Ghostfish in"
          f" group:{VALID_BORG_ALLOC_SUBSTR}) instead."
      )
    if prefix not in MLCR_WARM_POOL_TOPOLOGY_PREFIXES:
      raise ValueError(
          f"[{TRAP36H_MLCR_GHOSTFISH_SILENT_PATHWAYS_FALLBACK}] Topology prefix"
          f" '{prefix}' (from '{topology}') is not in"
          " MLCR_WARM_POOL_TOPOLOGY_PREFIXES"
          f" {MLCR_WARM_POOL_TOPOLOGY_PREFIXES}; '--mode=mlcr' would silently"
          " degrade to a self-owned Pathways cluster."
      )

  if mode_clean == "auto":
    if prefix in MLCR_WARM_POOL_TOPOLOGY_PREFIXES:
      effective_mode = "mlcr"
      minibench_flag_mode = "mlcr"
      execution_target = "mlcr_warm_pool"
      reason = (
          f"Auto-routed topology '{canonical_topology}' (prefix '{prefix}' in "
          "MLCR_WARM_POOL_TOPOLOGY_PREFIXES) to '--mode=mlcr' warm pool."
      )
    elif is_gf:
      if is_multihost_topology(canonical_topology, accelerator):
        effective_mode = "xm_pathways"
        minibench_flag_mode = "pathways"
        execution_target = "xmanager_borg_minibench"
        reason = (
            f"Auto-routed multi-host Ghostfish '{canonical_topology}' to"
            " XManager Borg 'launch_minibench_xm --mode=pathways' (avoiding"
            " silent MLCR fallback)."
        )
      else:
        effective_mode = "local_hermetic"
        minibench_flag_mode = "local_hermetic"
        execution_target = "forge_tpu_minibench"
        reason = (
            f"Auto-routed single-host Ghostfish '{canonical_topology}' to Forge"
            " hermetic '--mode=local_hermetic' (avoiding silent MLCR fallback"
            " per TRAP36H)."
        )
    else:
      raise ValueError(
          f"[{TRAP36H_MLCR_GHOSTFISH_SILENT_PATHWAYS_FALLBACK}] Unrecognized"
          f" topology '{topology}' (prefix='{prefix}') for minibench auto"
          f" routing; expected one of {MLCR_WARM_POOL_TOPOLOGY_PREFIXES} or"
          " Ghostfish ('gf')."
      )
  elif mode_clean == "mlcr":
    effective_mode = "mlcr"
    minibench_flag_mode = "mlcr"
    execution_target = "mlcr_warm_pool"
    reason = (
        "Validated explicit '--mode=mlcr' on supported warm-pool topology"
        f" '{canonical_topology}'."
    )
  elif mode_clean == "local_hermetic":
    if is_gf and is_multihost_topology(canonical_topology, accelerator):
      raise ValueError(
          f"[{TRAP36E_MULTIHOST_REQUIRES_XMANAGER_BORG}] Multi-host Ghostfish"
          f" topology '{canonical_topology}' cannot run in single-host Forge"
          " 'local_hermetic' mode; use '--minibench-mode=xm_pathways' or"
          " '--minibench-mode=xm_local'."
      )
    effective_mode = "local_hermetic"
    minibench_flag_mode = "local_hermetic"
    execution_target = "forge_tpu_minibench"
    reason = (
        f"Validated explicit '--mode=local_hermetic' on '{canonical_topology}'."
    )
  elif mode_clean in ("xm_local", "xm_pathways"):
    effective_mode = mode_clean
    minibench_flag_mode = "local" if mode_clean == "xm_local" else "pathways"
    execution_target = "xmanager_borg_minibench"
    reason = (
        f"Validated explicit '{mode_clean}' ('launch_minibench_xm"
        f" --mode={minibench_flag_mode}') on '{canonical_topology}'."
    )
  else:  # llo_orchestrate
    effective_mode = "llo_orchestrate"
    minibench_flag_mode = "llo_orchestrate"
    execution_target = "minibench_cli_llo_orchestrate"
    reason = (
        "Validated 'minibench_cli llo_orchestrate' comparative LLO"
        " orchestration mode."
    )

  if (
      effective_mode in ("xm_local", "xm_pathways")
      and VALID_BORG_ALLOC_SUBSTR not in borg_alloc
  ):
    raise ValueError(
        "[TRAP36_INVALID_XM_BORG_ALLOC_OR_PLATFORM] Invalid Borg alloc"
        f" {borg_alloc!r}; must use {VALID_BORG_ALLOC_SUBSTR!r}."
    )

  return {
      "status": "VALID",
      "backend": "minibench",
      "requested_mode": mode_clean,
      "effective_mode": effective_mode,
      "resolved_mode": effective_mode,
      "minibench_flag_mode": minibench_flag_mode,
      "execution_target": execution_target,
      "topology_prefix": prefix,
      "topology_shape": shape,
      "canonical_topology": canonical_topology,
      "is_ghostfish": is_gf,
      "reference_code": reference_code,
      "custom_code": custom_code,
      "input_generation_code": input_generation_code,
      "kernel_item": kernel_item,
      "kernelbench_profile_llo": bool(kernelbench_profile_llo),
      "enable_percale": bool(enable_percale),
      "generate_runtime_llo_report": bool(generate_runtime_llo_report),
      "borg_alloc": borg_alloc,
      "reason": reason,
  }


def build_minibench_command(
    *,
    topology: str = "gf=1x1x1",
    tpu_topology: Optional[str] = None,
    accelerator: str = "tpu7x",
    minibench_mode: str = "auto",
    reference_code: Optional[str] = None,
    custom_code: Optional[str] = None,
    input_generation_code: Optional[str] = None,
    kernel_item: str = "",
    output_dir: str = "/tmp/minibench_out",
    temp_dir: str = "/tmp/minibench_exec",
    kernelbench_profile_llo: bool = True,
    enable_percale: bool = True,
    generate_runtime_llo_report: bool = True,
    borg_alloc: str = f"group:{VALID_BORG_ALLOC_SUBSTR}",
    baseline_trace: str = "/tmp/baseline.pb",
    treatment_trace: str = "/tmp/treatment.pb",
    baseline_db: str = "/tmp/baseline.db",
    treatment_db: str = "/tmp/treatment.db",
    min_speedup: float = 15.0,
    output_md: str = "",
    output_json: str = "",
    extra_dump_flags: Sequence[str] = (),
    allow_tiny_shape_waiver: bool = False,
) -> Dict[str, Any]:
  """Validate and construct the Google3 Minibench / MLCR / Forge / XM command line."""
  del allow_tiny_shape_waiver
  effective_topo = tpu_topology or topology
  validated = validate_minibench_command_and_spec(
      topology=effective_topo,
      accelerator=accelerator,
      minibench_mode=minibench_mode,
      reference_code=reference_code or "",
      custom_code=custom_code or "",
      input_generation_code=input_generation_code or "",
      kernel_item=kernel_item,
      kernelbench_profile_llo=kernelbench_profile_llo,
      enable_percale=enable_percale,
      generate_runtime_llo_report=generate_runtime_llo_report,
      borg_alloc=borg_alloc,
  )
  eff_mode = validated["effective_mode"]
  flag_mode = validated["minibench_flag_mode"]
  canon_topo = validated["canonical_topology"]

  code_flags: List[str] = []
  if kernel_item:
    code_flags.append(f"--kernel_item={kernel_item}")
  if reference_code:
    code_flags.append(f"--reference_code={reference_code}")
  if custom_code:
    code_flags.append(f"--custom_code={custom_code}")
  if input_generation_code:
    code_flags.append(f"--input_generation_code={input_generation_code}")
  if kernelbench_profile_llo:
    code_flags.append("--kernelbench_profile_llo")
  if enable_percale:
    code_flags.append("--enable_percale")
  if generate_runtime_llo_report:
    code_flags.append("--generate_runtime_llo_report")
  for df in extra_dump_flags:
    if df:
      code_flags.append(df)

  forge_test_command: List[str] = []
  if eff_mode == "llo_orchestrate":
    md_out = output_md or str(Path(output_dir) / "llo_report.md")
    json_out = output_json or str(Path(output_dir) / "llo_telemetry.json")
    cmd = [
        "/google/bin/releases/arca9-local-blaze-cli/blaze-for-agents",
        "run",
        "-c",
        "opt",
        "//learning/performance/agents/tools/minibench/llo_analysis:llo_orchestrate",
        "--",
        f"--baseline_trace={baseline_trace}",
        f"--treatment_trace={treatment_trace}",
        f"--baseline_db={baseline_db}",
        f"--treatment_db={treatment_db}",
        f"--min_speedup={min_speedup}",
        f"--output_md={md_out}",
        f"--output_json={json_out}",
        *code_flags,
    ]
  elif eff_mode in ("xm_local", "xm_pathways"):
    cmd = [
        "/google/bin/releases/xmanager/cli/xmanager",
        "launch",
        "--xm_build_from_citc",
        "//learning/performance/agents/tools/minibench:launch_minibench_xm",
        "--",
        f"--mode={flag_mode}",
        f"--tpu_topology={canon_topo}",
        "--pathways_mpm_version=live",
        f"--xm_resource_alloc={borg_alloc}",
        "--noxm_monitor_on_launch",
        "--xm_skip_launch_confirmation",
        f"--output_dir={output_dir}",
        *code_flags,
    ]
  elif eff_mode == "local_hermetic":
    target_suffix = (
        "2x2x1"
        if validated["topology_shape"] in ("2x2x1", "1x2x1")
        else "1x1x1"
    )
    hermetic_target = f"//learning/performance/agents/tools/minibench:run_minibench_gf_{target_suffix}"
    cmd = [
        "/google/bin/releases/arca9-local-blaze-cli/blaze-for-agents",
        "test",
        "-c",
        "opt",
        "--test_strategy=remote",
        "--nocache_test_results",
        "--test_output=errors",
        hermetic_target,
        f"--test_arg=--mode={flag_mode}",
        f"--test_arg=--tpu_topology={canon_topo}",
        f"--test_arg=--output_dir={output_dir}",
        "--mode=local_hermetic",
        f"--tpu_topology={canon_topo}",
        *code_flags,
    ]
    forge_test_command = list(cmd)
  else:  # "mlcr"
    cmd = [
        "/google/bin/releases/arca9-local-blaze-cli/blaze-for-agents",
        "run",
        "-c",
        "opt",
        "//learning/performance/agents/tools/minibench:minibench",
        "--",
        f"--mode={flag_mode}",
        f"--tpu_topology={canon_topo}",
        f"--output_dir={output_dir}",
        f"--temp_dir={temp_dir}",
        *code_flags,
    ]

  out = dict(validated)
  out["command"] = cmd
  out["forge_test_command"] = forge_test_command
  return out


def resolve_backend(
    backend: str = "auto",
    *,
    topology: str = "2x2x1",
    accelerator: str = "tpu7x",
    active_deadline_seconds: int = 7200,
    has_sweep_axes: bool = False,
    reference_code: Optional[str] = None,
    custom_code: Optional[str] = None,
    input_generation_code: Optional[str] = None,
    kernel_item: str = "",
    minibench_mode: str = "auto",
    kernelbench_profile_llo: bool = True,
    enable_percale: bool = True,
    generate_runtime_llo_report: bool = True,
    borg_alloc: str = f"group:{VALID_BORG_ALLOC_SUBSTR}",
    output_dir: str = "/tmp/minibench_out",
) -> Dict[str, Any]:
  """Resolve one of the 3 execution backends (`forge`, `minibench`, `xmanager`)."""
  b_clean = (backend or "auto").strip().lower()
  if b_clean not in SUPPORTED_BACKENDS:
    raise ValueError(
        f"Unsupported backend={backend!r}; must be one of {SUPPORTED_BACKENDS}."
    )

  prefix, _, canon_topo = parse_topology_prefix_and_shape(topology, accelerator)
  has_minibench_inputs = (
      any(
          bool(x and str(x).strip())
          for x in (
              reference_code,
              custom_code,
              input_generation_code,
              kernel_item,
          )
      )
      or (minibench_mode or "auto").strip().lower() != "auto"
  )

  if b_clean == "minibench" or (
      b_clean == "auto"
      and (has_minibench_inputs or prefix in MLCR_WARM_POOL_TOPOLOGY_PREFIXES)
  ):
    mb = build_minibench_command(
        topology=topology,
        accelerator=accelerator,
        minibench_mode=minibench_mode,
        reference_code=reference_code or "",
        custom_code=custom_code or "",
        input_generation_code=input_generation_code or "",
        kernel_item=kernel_item,
        output_dir=output_dir,
        kernelbench_profile_llo=kernelbench_profile_llo,
        enable_percale=enable_percale,
        generate_runtime_llo_report=generate_runtime_llo_report,
        borg_alloc=borg_alloc,
    )
    return {
        "status": "RESOLVED",
        "requested_backend": b_clean,
        "backend": "minibench",
        "resolved_backend": "minibench",
        "dispatch_mode": "minibench",
        "canonical_topology": canon_topo,
        "minibench_mode": mb["effective_mode"],
        "minibench_flag_mode": mb["minibench_flag_mode"],
        "execution_target": mb["execution_target"],
        "command": mb["command"],
        "forge_test_command": mb["forge_test_command"],
        "minibench_spec": mb,
        "reason": mb["reason"],
    }

  multihost = is_multihost_topology(topology, accelerator)
  if b_clean == "forge":
    if multihost:
      raise ValueError(
          f"[{TRAP36E_MULTIHOST_REQUIRES_XMANAGER_BORG}] Multi-host topology"
          f" '{canon_topo}' cannot run on single-host Forge TPU; use"
          " '--backend=xmanager' or '--backend=minibench'."
      )
    return {
        "status": "RESOLVED",
        "requested_backend": b_clean,
        "backend": "forge",
        "resolved_backend": "forge",
        "minibench_mode": "none",
        "dispatch_mode": "forge_tpu",
        "canonical_topology": canon_topo,
        "reason": (
            f"Selected Backend A (Forge TPU) for single-host '{canon_topo}'."
        ),
    }

  if (
      b_clean == "xmanager"
      or multihost
      or active_deadline_seconds > 900
      or has_sweep_axes
  ):
    if VALID_BORG_ALLOC_SUBSTR not in borg_alloc:
      raise ValueError(
          "[TRAP36_INVALID_XM_BORG_ALLOC_OR_PLATFORM] Invalid Borg alloc"
          f" {borg_alloc!r}; must use {VALID_BORG_ALLOC_SUBSTR!r}."
      )
    return {
        "status": "RESOLVED",
        "requested_backend": b_clean,
        "backend": "xmanager",
        "resolved_backend": "xmanager",
        "minibench_mode": "none",
        "dispatch_mode": "xmanager_borg",
        "canonical_topology": canon_topo,
        "reason": f"Selected Backend C (XManager Borg TPU) for '{canon_topo}'.",
    }

  return {
      "status": "RESOLVED",
      "requested_backend": b_clean,
      "backend": "forge",
      "resolved_backend": "forge",
      "minibench_mode": "none",
      "dispatch_mode": "forge_tpu",
      "canonical_topology": canon_topo,
      "reason": (
          f"Auto-selected Backend A (Forge TPU) for single-host '{canon_topo}'"
          " (<= 900s)."
      ),
  }


def synthesize_xm_borg_launcher_script(
    request: Dict[str, Any], storage_uri: str
) -> str:
  """Generate an XManager (`xm_abc.Borg`) launcher script for a queued `cdk-g3` job."""
  job_id = request["id"]
  job_name = request["recipe"]
  topology = request.get("topology") or "2x2x1"
  alloc = request.get("borg_alloc") or f"group:{VALID_BORG_ALLOC_SUBSTR}"
  if VALID_BORG_ALLOC_SUBSTR not in alloc:
    raise ValueError(
        "[TRAP36_INVALID_XM_BORG_ALLOC_OR_PLATFORM] Invalid Borg alloc"
        f" {alloc!r}; must use {VALID_BORG_ALLOC_SUBSTR!r}."
    )
  pod_name = request["pod_name"]
  env_dict = dict(request.get("env") or {})
  env_dict["POD_NAME"] = pod_name
  env_dict["CDK_G3_JOB_ID"] = job_id
  env_dict["CDK_G3_STORAGE_URI"] = storage_uri

  return (
      "from xmanager import xm\nfrom xmanager import xm_abc\n\nJOB_ID ="
      f" {job_id!r}\nJOB_NAME = {job_name!r}\nBORG_ALLOC = {alloc!r}\nTOPOLOGY"
      f" = {topology!r}\nENV_VARS ="
      f" {json.dumps(env_dict, sort_keys=True)}\n\ndef main(argv) -> None:\n "
      " del argv\n  with"
      " xm_abc.create_experiment(experiment_title=f'cdk_g3_{JOB_NAME}_{JOB_ID}')"
      " as exp:\n    requirements = xm.JobRequirements(\n       "
      " location='us-central1',\n        service_tier=xm.ServiceTier.PROD,\n  "
      "       ghostfish=TOPOLOGY,\n    )\n    executor ="
      " xm_abc.Borg(alloc=BORG_ALLOC, requirements=requirements)\n    pkg, ="
      " exp.package([\n        xm.python_container(\n           "
      " executor_spec=executor.Spec(),\n            path='.',\n           "
      " base_image='gcr.io/deeplearning-platform-release/base-cpu',\n         "
      "   entrypoint=xm.CommandList(['bash', '/workspace/pod_script.sh']),\n  "
      "      )\n    ])\n    exp.add(xm.Job(pkg, executor,"
      " env_vars=ENV_VARS))\n"
  )


# ---------------------------------------------------------------------------
# Stateless `cdk-g3` Client Subcommands
# ---------------------------------------------------------------------------


def cmd_agent_letter() -> int:
  sys.stdout.write(AGENT_LETTER_TEXT)
  sys.stdout.flush()
  return 0


def cmd_usage(store: StorageBackend, as_json: bool) -> int:
  nodes = build_cluster_usage_nodes(store)
  try:
    store.write_json("cluster/usage.json", nodes)
  except Exception:
    pass
  if as_json:
    sys.stdout.write(json.dumps(nodes, indent=2, sort_keys=True) + "\n")
  else:
    for n in nodes:
      busy = len(n.get("pods") or [])
      sys.stdout.write(
          f"{n['name']:<32} {n['node_pool']:<24} {n['status']:<8} busy={busy}\n"
      )
  sys.stdout.flush()
  return 0


