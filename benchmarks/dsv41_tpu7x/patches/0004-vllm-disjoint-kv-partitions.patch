+            swa_idx = 0
             for manager, group in zip(
                 self.single_type_managers, self.kv_cache_config.kv_cache_groups
             ):
@@ -194,7 +206,11 @@ class KVCacheCoordinator(ABC):
                     ):
                         manager.pool_partition = "state"
                     else:
-                        manager.pool_partition = "swa"
+                        if getattr(self.block_pool, "_disjoint_aux_partitions", False):
+                            manager.pool_partition = f"swa_{swa_idx}"
+                            swa_idx += 1
