diff --git a/vllm/v1/core/sched/scheduler.py b/vllm/v1/core/sched/scheduler.py
index de16b3ff12..b9922f7a9e 100644
--- a/vllm/v1/core/sched/scheduler.py
+++ b/vllm/v1/core/sched/scheduler.py
@@ -1202,6 +1202,36 @@ class Scheduler(SchedulerInterface):
                         # we can stop the scheduling here.
                         break
 
+                    if (
+                        os.environ.get("TPU_RAIDEN_DSV4_MAX_TRANSFER_LAYER")
+                        and os.environ.get("VLLM_DSV41_PURE_20L_PREFILL") != "1"
+                        and (
+                            scheduled_running_reqs
+                            or scheduled_new_reqs
+                            or scheduled_resumed_reqs
+                        )
+                        and num_computed_tokens > 0
+                        and 1 < num_new_tokens <= self.max_num_scheduled_tokens
+                        and num_new_tokens > request_token_budget
+                    ):
+                        # Never split a 128-token SWA tail replay across two steps on Decode.
+                        break
+
+                    if (
+                        os.environ.get("VLLM_DSV41_PURE_20L_PREFILL") == "1"
+                        and (
+                            scheduled_running_reqs
+                            or scheduled_new_reqs
+                            or scheduled_resumed_reqs
+                        )
+                        and request_token_budget < 1024
+                        and num_new_tokens > request_token_budget
+                    ):
+                        # Avoid splitting a new long prefill into a tiny <1024-token
+                        # tail sliver (e.g. 128 tokens left from PD handoff truncation),
+                        # which would add an extra 16K XLA step to every subsequent prompt.
+                        break
+
                     num_new_tokens = min(num_new_tokens, request_token_budget)
                     assert num_new_tokens > 0
 
@@ -3106,6 +3136,15 @@ class Scheduler(SchedulerInterface):
                 self.kv_cache_manager.free(request)
 
             self.failed_recving_kv_req_ids.remove(request.request_id)
+        elif (
+            request.num_computed_tokens <= 1
+            and os.environ.get("TPU_RAIDEN_DSV4_MAX_TRANSFER_LAYER")
+        ):
+            # Short prompt (N <= tail_tokens + 1) in 20L prefill mode:
+            # Stage-3 pulled 1 token to unpin the producer registration cleanly,
+            # but layers 20..39 SWA need token 0 computed locally on Decode.
+            request.num_computed_tokens = 0
+            self.kv_cache_manager.free(request)
         else:
             # Now that the blocks are ready, actually cache them.
             # This will cache the blocks iff caching is enabled.
