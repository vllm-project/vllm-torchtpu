+                            manager.pool_partition = "swa"
 
         # A positive retention interval must be a multiple of the base hit granularity
         # (``scheduler_block_size``) to land on real cache-hit boundaries.
@@ -241,9 +257,7 @@ class KVCacheCoordinator(ABC):
 
         """
         num_blocks_to_allocate = 0
-        main_blocks_to_allocate = 0
-        swa_blocks_to_allocate = 0
-        state_blocks_to_allocate = 0
+        by_partition: dict[str, int] = {}
         for i, manager in enumerate(self.single_type_managers):
             if isinstance(manager, CrossAttentionManager):
                 # For cross-attention, we issue a single static allocation
@@ -268,27 +282,29 @@ class KVCacheCoordinator(ABC):
                     apply_admission_cap=apply_admission_cap,
                 )
             num_blocks_to_allocate += req_b
-            if manager.pool_partition == "swa":
-                swa_blocks_to_allocate += req_b
-            elif manager.pool_partition == "state":
-                state_blocks_to_allocate += req_b
-            else:
-                main_blocks_to_allocate += req_b
+            part = manager.pool_partition or "main"
+            by_partition[part] = by_partition.get(part, 0) + req_b
         if self.block_pool.swa_free_block_queue is not None:
-            main_free = self.block_pool.get_num_free_blocks("main")
-            if main_blocks_to_allocate > main_free:
-                return self.block_pool.num_gpu_blocks + 1
-            swa_free = self.block_pool.swa_free_block_queue.num_free_blocks
-            state_free = (
-                self.block_pool.state_free_block_queue.num_free_blocks
-                if self.block_pool.state_free_block_queue is not None
-                else 0
-            )
-            borrowed_needed = max(0, swa_blocks_to_allocate - swa_free) + max(
-                0, state_blocks_to_allocate - state_free
-            )
-            if main_blocks_to_allocate + borrowed_needed > main_free:
-                return self.block_pool.num_gpu_blocks + 1
+            if getattr(self.block_pool, "_disjoint_aux_partitions", False):
+                for part, needed in by_partition.items():
+                    if needed > self.block_pool.get_num_free_blocks(part):
+                        return self.block_pool.num_gpu_blocks + 1
+            else:
+                main_free = self.block_pool.get_num_free_blocks("main")
+                main_blocks_to_allocate = by_partition.get("main", 0)
+                if main_blocks_to_allocate > main_free:
+                    return self.block_pool.num_gpu_blocks + 1
+                swa_free = self.block_pool.swa_free_block_queue.num_free_blocks
+                state_free = (
+                    self.block_pool.state_free_block_queue.num_free_blocks
+                    if self.block_pool.state_free_block_queue is not None
+                    else 0
+                )
+                borrowed_needed = max(
+                    0, by_partition.get("swa", 0) - swa_free
+                ) + max(0, by_partition.get("state", 0) - state_free)
+                if main_blocks_to_allocate + borrowed_needed > main_free:
+                    return self.block_pool.num_gpu_blocks + 1
         return num_blocks_to_allocate
 
