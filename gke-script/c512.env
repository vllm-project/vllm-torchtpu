# shellcheck shell=bash
# AgentX c512 配置（scripts/dsv41_pd/REPRODUCE.zh.md 5.7，agentx-c512-sampled-3600-1116-0504）：
#   source c512.env && bash deploy.sh        # 服务端 + proxy
#   source c512.env && bash run_agentx.sh    # 压测
# 和参考运行的差别：TPU_RECLAIM_COMPILE_MEMORY 保持 0（pod 里 deadsnakes 的 python3.12 不是 PIE，开了会在编译时报错）；
# 2P1D 时 proxy 的前缀路由跨两个 P 共 16 个 rank（PROXY_PREFILL_INSTANCES 由 pod_proxy.sh 自动设置）。
export P_ENV="EXTRA_ARGS=--enable-prompt-tokens-details"
export D_ENV="MAX_NUM_SEQS=64 DECODE_COMPILE_SIZES=[16,48,96,144,192,288,384,2048] TPU_DSPARK_SAMPLED_DRAFT=1"
export PROXY_SESSION_AFFINITY_DP=8 PROXY_DECODE_ROUTING=1 PROXY_HIT_DIAG=1
export CONC=512 DURATION=${DURATION:-3600}
