# shellcheck shell=bash
# AgentX c512，代码 = /zzlfs/temu/vllm-torchtpu-csa2（cszhz/dsv41-1p1d-csa2opt：PD 分支 + 兼容的 upstream 修复 + CSA2 优化移植 + P 的 whale 调度）。
# 服务端参数和 VM 1P1D 的 scripts/dsv41_pd/cc_sync_test.sh 对齐（P：whale 16k + TpuDpAttnBalanceScheduler；两边 DSpark 采样 draft）。
# 启动脚本 / proxy 仍用本仓库（1p1d）的：start_1p1d_epic.sh 只多了 engine id 覆盖，proxy 多了跨 P 路由。
#   source c512-csa2.env && bash deploy.sh
export COMMON_ENV="CODE_DIR=/zzlfs/temu/vllm-torchtpu-csa2 TPU_DSPARK_SAMPLED_DRAFT=1"
# EXTRA_ARGS 里有空格：单引号由 pod 里的 shell 解析（deploy.sh 把整串交给 bash -c）
export P_ENV="TPU_DP_ATTN_STEP_CAP=0 TPU_P_WHALE_TOKENS=16384 TPU_P_WHALE_STEP_TOKENS=1024 EXTRA_ARGS='--enable-prompt-tokens-details --scheduler-cls vllm_torchtpu.core.dp_attn_balance_scheduler.TpuDpAttnBalanceScheduler'"
export D_ENV="MAX_NUM_SEQS=64 DECODE_COMPILE_SIZES=[16,48,96,144,192,288,384,2048]"
export PROXY_SESSION_AFFINITY_DP=8 PROXY_DECODE_ROUTING=1 PROXY_HIT_DIAG=1
export CONC=512 DURATION=${DURATION:-3600}
