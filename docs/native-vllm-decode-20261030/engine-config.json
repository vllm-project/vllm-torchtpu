{
  "pipeline_parallel_size": 1,
  "data_parallel_size": 8,
  "data_parallel_size_local": 2,
  "nnodes": 1,
  "distributed_executor_backend": "mp",
  "data_parallel_backend": "mp",
  "cpu_distributed_timeout_seconds": 14400,
  "master_port": 29500,
  "safetensors_load_strategy": "lazy",
  "enable_ep_weight_filter": true,
  "dtype": "bfloat16",
  "quantization": null,
  "language_model_only": true,
  "max_model_len": 1048576,
  "gpu_memory_utilization": 0.9,
  "cp_kv_cache_interleave_size": 256,
  "attention_backend": "CUSTOM",
  "kv_cache_dtype": "fp8",
  "mamba_ssm_cache_dtype": "bfloat16",
  "enable_expert_parallel": true,
  "disable_custom_all_reduce": true,
  "enable_prefix_caching": false,
  "disable_hybrid_kv_cache_manager": false,
  "async_scheduling": true,
  "enforce_eager": false,
  "additional_config": {
    "tpu_online_fp8": {
      "enabled": true,
      "weight_scheme": "per_channel",
      "targets": [
        "model.layers.*.self_attn.qkv_proj",
        "model.layers.*.self_attn.o_proj",
        "model.layers.*.linear_attn.in_proj_qkvz",
        "model.layers.*.linear_attn.in_proj_ba",
        "model.layers.*.linear_attn.out_proj",
        "model.layers.*.mlp.shared_expert.gate_up_proj",
        "model.layers.*.mlp.shared_expert.down_proj"
      ],
      "exclude": [
        "model.layers.*.mlp.experts*"
      ]
    }
  },
  "seed": 42,
  "generation_config": "vllm",
  "mamba_cache_mode": "align",
  "load_format": "dummy",
  "hf_overrides": {
    "max_position_embeddings": 1048576,
    "rope_parameters": {
      "partial_rotary_factor": 0.25,
      "rope_theta": 10000000,
      "type": "yarn",
      "rope_type": "yarn",
      "factor": 4,
      "original_max_position_embeddings": 262144
    }
  },
  "limit_mm_per_prompt": {
    "image": 0,
    "video": 0
  },
  "block_size": 384,
  "tensor_parallel_size": 4,
  "data_parallel_hybrid_lb": true,
  "prefill_context_parallel_size": 1,
  "decode_context_parallel_size": 1,
  "max_num_batched_tokens": 1024,
  "max_num_seqs": 12,
  "compilation_config": {
    "backend": "vllm_torchtpu.compilation.tpu_compiler.TpuCompilerAdaptor",
    "compile_sizes": [
      12,
      48,
      1024
    ],
    "inductor_compile_config": {
      "enable_auto_functionalized_v2": false,
      "size_asserts": false,
      "alignment_asserts": false,
      "scalar_asserts": false
    }
  },
  "speculative_config": {
    "method": "mtp",
    "num_speculative_tokens": 3
  },
  "data_parallel_address": "${MASTER_ADDRESS}",
  "model": "${MODEL_PATH}",
  "served_model_name": "qwen38-native-dummy",
  "host": "0.0.0.0",
  "port": 8000,
  "data_parallel_rpc_port": 29650,
  "enable_prompt_tokens_details": true,
  "kv_cache_memory_bytes": 25769803776,
  "kv_transfer_config": {
    "kv_connector": "DecodeBenchConnector",
    "kv_connector_module_path": "synthetic_decode_connector",
    "kv_role": "kv_both",
    "kv_connector_extra_config": {
      "synthetic_decode_benchmark": true
    }
  }
}
